#
# `dependent: :destroy` destroys them first when this record is destroyed,
# each with its callbacks and its own dependents; `dependent: :delete_all`
# deletes their rows in one statement, without loading them.
#
# `through:` reaches them across another table, as Rails' has_many
# :through:
#
#   class Post < ApplicationRecord
#     has_many taggings : Tagging
#     has_many tags : Tag, through: :taggings      # taggings.post_id, taggings.tag_id
#   end
#
#   class User < ApplicationRecord
#     has_many posts : Post
#     has_many comments : Comment, through: :posts # posts.user_id, comments.post_id
#   end
#
# The through table is the one the name says (`taggings`); which side holds
# the key is read from the target's columns (a Comment with `post_id`
# belongs to the through table, a Tag without `tagging_id` is pointed at by
# `taggings.tag_id`). `source_key:` names that key when it is not
# `<target>_id`. A through association is a query (`post.tags.order(:name)`)
# and can be joined (`Post.joins(:tags)`); `includes` does not load it.
pub macro has_many(decl, foreign_key = nil, dependent = nil, through = nil, source_key = nil)
  {% key = foreign_key ? foreign_key.id.stringify : (@type.name.split("::").last.underscore + "_id") %}
  {% if through %}
    {% middle = through.id.stringify %}
    {% middle_one = middle.ends_with?("ies") ? middle[0...-3] + "y" : (middle.ends_with?("ses") || middle.ends_with?("xes") ? middle[0...-2] : (middle.ends_with?("s") ? middle[0...-1] : middle)) %}
    {% target = decl.var.stringify %}
    {% target_one = target.ends_with?("ies") ? target[0...-3] + "y" : (target.ends_with?("ses") || target.ends_with?("xes") ? target[0...-2] : (target.ends_with?("s") ? target[0...-1] : target)) %}
    {% source = source_key ? source_key.id.stringify : target_one + "_id" %}
    {% back = middle_one + "_id" %}

