      {% end %}
    {% end %}
    self
  end
end

# `belongs_to user : User` writes `user`, the linked record by the `user_id`
# column, and `user?`, nil when the link is empty or dangling.
# `belongs_to author : User, foreign_key: writer_id` names another column.
pub macro belongs_to(decl, foreign_key = nil)
  {% key = foreign_key ? foreign_key.id : (decl.var.stringify + "_id").id %}
  @[::Db::Serializable::DBField(ignore: true)]
  @__kurt_{{ decl.var }}_loaded : Bool = false

  @[::Db::Serializable::DBField(ignore: true)]
  @__kurt_{{ decl.var }} : {{ decl.type }}? = nil

  def {{ decl.var }} : {{ decl.type }} | ::Kurt::Model::NotFound | ::Db::Errors::DBError
    if @__kurt_{{ decl.var }}_loaded
      return @__kurt_{{ decl.var }} || ::Kurt::Model::NotFound.new({{ decl.type.stringify }})
    end
    {{ decl.type }}.find({{ key }})
  end

