      there = {{ decl.type }}.table_name
      # The target holds the key ({{ decl.type }}.{{ back.id }}), or the
      # through table does ({{ middle.id }}.{{ source.id }}).
      link = \{% if {{ decl.type }}.instance_vars.any? { |v| v.name == {{ back }} } %}there + "." + {{ back }} + " = " + {{ middle }} + ".id"\{% else %}{{ middle }} + "." + {{ source }} + " = " + there + ".id"\{% end %}
      if from_owner
        kind + " JOIN " + {{ middle }} + " ON " + {{ middle + "." + key }} + " = " + table_name + ".id " + kind + " JOIN " + there + " ON " + link
      else
        kind + " JOIN " + {{ middle }} + " ON " + link
      end
    end

    ::Kurt::Model.__kurt_join_link({{ decl.var.stringify }}, {{ @type.class.methods.any? { |m| m.name == "__kurt_join_sql" } }}) do |kind|
      __kurt_through_{{ decl.var }}(kind, true)
    end
  {% else %}
  @[::Db::Serializable::DBField(ignore: true)]
  @__kurt_{{ decl.var }} : Array({{ decl.type }})? = nil

  def {{ decl.var }} : ::Kurt::Model::Query({{ decl.type }})
    found = {{ decl.type }}.query.where({{ key }}, @id)
    if loaded = @__kurt_{{ decl.var }}
      found.__kurt_preload_rows(loaded)
    end
    found
  end

  def __kurt_set_{{ decl.var }}(rows : Array({{ decl.type }})) : Nil
    @__kurt_{{ decl.var }} = rows
  end

  ::Kurt::Model.__kurt_join_link({{ decl.var.stringify }}, {{ @type.class.methods.any? { |m| m.name == "__kurt_join_sql" } }}) do |kind|
    kind + " JOIN " + {{ decl.type }}.table_name + " ON " + {{ decl.type }}.table_name + "." + {{ key }} + " = " + table_name + ".id"
  end

  ::Kurt::Model.__kurt_preload_link({{ decl.var.stringify }}, {{ @type.methods.any? { |m| m.name == "__kurt_preload_into" } }}) do |records, on|
    ids = records.map { |record| record.id.as(::Db::Value::DBValue) }
    children = ids.empty? ? [] of {{ decl.type }} : {{ decl.type }}.query.on(on).where_in({{ key }}, ids).all!
    grouped = {} of Int64 => Array({{ decl.type }})
    children.each do |child|
      owner = child.{{ key.id }}.to_i64
      (grouped[owner] ||= [] of {{ decl.type }}) << child
    end
    records.each { |record| record.__kurt_set_{{ decl.var }}(grouped[record.id]? || [] of {{ decl.type }}) }
  end
  {% if dependent %}
    ::Kurt::Model.__kurt_dependent({{ decl.type }}, {{ key }}, {{ dependent }}, {{ @type.methods.any? { |m| m.name == "__kurt_dependents" } }})
  {% end %}
