# The model layer: a table mapped to a class by one `derive model`, a query
# builder over the `db` package, relations as macros, validation.
#
#   @[Table("posts")]                # optional: the default is the plural of
#   class Post                       # the class name, underscored
#     property title : String
#     property body : String
#     property user_id : Int64
#
#     belongs_to user : User         # relations go ABOVE the derive: a
#     has_many comments : Comment    # derive reads the declarations above it
#
#     validates :title, presence: true   # Rails' validations and callbacks,
#     before_save :set_slug              # also above the derive
#
#     derive model
#
#     def validate(errors : Errors) : Nil   # rules of your own
#       errors.add("title", "can't be blank") if title.empty?
#     end
#   end
#
#   Post.all!                                    # Array(Post) | DBError
#   Post.find(1)!                                # Post | NotFound | DBError
#   Post.where(published: true).order_desc(:id).limit(10).all!
#   Post.title("Hello").first?!                  # one typed finder per field
#   post = Post.create(title: "Hi", body: "...", user_id: 1)!   # | Invalid
#   post.user!.name
#   post.comments.order(:id).all!
#
# Why macros and not annotations for relations: a derive is handed the type's
# name and its fields with their types, nothing else (SPEC.md II.4), so it
# cannot see `@[BelongsTo(User)]`. A macro called in the class body reads only
# its own arguments, which R-5 allows. That was Phase 0's gate.
module model

import std/text
import db/db/core::{Database}
import db/db/errors::{DBError}
import db/db/value::{DBValue}
import std/time::{Time}
import std/regex::{Regex}
import std/password::{Bcrypt}
import environment::{env}
import datasource::{database, placeholders, postgres?}

pub import db/db/serializable
pub import db/db/value
pub import inflector

# ---------------------------------------------------------------------------
# Errors a model answers. None of them knows about HTTP: the controller layer
# turns them into responses, in one place (controllers.install_error_pages).
# ---------------------------------------------------------------------------

# A query ran and found no row: `find`, `first`, a `belongs_to` link.
pub class NotFound
  getter message : String
  getter model : String

  def initialize(@model : String, @message : String = "")
    @message = @model + " not found" if @message.empty?
  end
end

impl Error for NotFound
  def message : String
    @message
  end
end

# The messages validation collected, field by field.
pub class Errors
  @messages : Hash(String, Array(String))

  def initialize
    @messages = {} of String => Array(String)
  end

  # The same message twice on one field is kept once: a blank `user_id`
  # that did not convert and failed `presence` is one problem.
  def add(field : String, message : String) : Nil
    list = @messages[field]? || [] of String
    return if list.includes?(message)
    list << message
    @messages[field] = list
    nil
  end

  def empty? : Bool
    @messages.empty?
  end

  def any? : Bool
    !@messages.empty?
  end

  def size : Int32
    count = 0
    @messages.each_value { |list| count += list.size }
    count
  end

  # Messages for one field, empty when it has none.
  def on(field : String) : Array(String)
    @messages[field]? || [] of String
  end

  def fields : Array(String)
    @messages.keys
  end

  # "title can't be blank", one per message.
  def full_messages : Array(String)
    out = [] of String
    @messages.each do |field, list|
      list.each { |message| out << field + " " + message }
    end
    out
  end

  def to_h : Hash(String, Array(String))
    @messages
  end
end

# A record that did not pass validation, and why. `save` answers it instead
# of writing anything.
pub class Invalid
  getter model : String
  getter errors : Errors

  def initialize(@model : String, @errors : Errors)
  end
end

impl Error for Invalid
  def message : String
    @model + " is invalid: " + @errors.full_messages.join(", ")
  end
end

# Overrides the table a model maps to: `@[Table("people")]`.
pub annotation Table
end

# ---------------------------------------------------------------------------
# Transactions. The transaction is handed on explicitly, `on: tx`, and not
# kept somewhere ambient: a server runs many requests at once, and a query
# that found "the current transaction" by itself could land in another
# request's.
#
#   Post.transaction do |tx|
#     post.save(on: tx)!
#     Comment.where(post_id: post.id).on(tx).delete_all!
#   end
#
# The block's error rolls everything back and is answered; so does leaving
# the block early (`!`). Otherwise it commits and answers the block's value.
# ---------------------------------------------------------------------------

pub class Transaction
  getter inner : ::Db::Core::Transaction

  def initialize(@inner : ::Db::Core::Transaction)
  end

  def connection : ::Db::Core::Connection
    @inner.connection
  end
end

# A transaction of its own, or one nested in *on* (a savepoint).
pub def transaction(on : Transaction? = nil, & : Transaction -> T) : T | Nil | DBError forall T
  if outer = on
    outer.inner.transaction { |tx| yield Transaction.new(tx) }
  else
    database.transaction { |tx| yield Transaction.new(tx) }
  end
end

# The mark a plain column name carries in a query's clauses until the SQL
# is written: there it becomes the table's name and a dot when the query
# joins other tables (`posts.title`), and nothing otherwise.
pub COLUMN_MARK = "\e"

# `title` as a query writes it: marked, so a join can qualify it; a name
# with a dot or anything but letters, digits and _ is written as it is.
pub def mark_column(column : String) : String
  return column if column.empty?
  column.each_char do |c|
    return column unless c.ascii_alphanumeric? || c == '_'
  end
  COLUMN_MARK + column
end

# A query against T's table, built up and run by `all`, `first`, `count`...
# Nothing runs until one of those is called, so a scope can be passed around
# and narrowed: `Post.feed.where(user_id: 5).limit(3).all`.
#
#   Post.joins(:user).where("users.name", "Ada").distinct.all!
#   Post.where(published: true).or_where(Post.where(user_id: 5)).count!
#   Post.pluck(:title, String)!                      # Array(String)
#   Post.where(published: true).sum(:views)!         # Float64
#   Post.group_by(:user_id).having("COUNT(*) > ?", [1]).counts!   # Hash(DBValue, Int64)
pub class Query(T)
  @wheres : Array(String)
  @args : Array(DBValue)
  @orders : Array(String)?
  @limit : Int32?
  @offset : Int32?
  @on : Transaction?
  @includes : Array(String)?
  @preloaded : Array(T)?
  @joins : Array(String)?
  @select : String?
  @distinct : Bool
  @groups : Array(String)?
  @havings : Array(String)?
  @having_args : Array(DBValue)?
  # What a part of the query could not be built from (an unknown
  # association): answered as a DBError when it runs.
  @failure : String?

  def initialize
    @wheres = [] of String
    @args = [] of DBValue
    # Made on first use: most queries never order or include, and a
    # has_many accessor builds a query per record (`post.comments`).
    @orders = nil
    @limit = nil
    @offset = nil
    @on = nil
    @includes = nil
    @preloaded = nil
    @joins = nil
    @select = nil
    @distinct = false
    @groups = nil
    @havings = nil
    @having_args = nil
    @failure = nil
  end

  # Loads associations with the rows, one query each, so a list does not
  # ask once per row (N+1): `Post.includes(:user, :comments).all!`, then
  # `post.user?` and `post.comments.all!` ask nothing more.
  def includes(*names : Symbol) : Query(T)
    list = @includes || [] of String
    names.each { |name| list << name.to_s }
    @includes = list
    self
  end

  # Rows `includes` loaded for a has_many: `all`, `count` and `first` answer
  # them; narrowing the query (`where`, `order`, `limit`...) asks again.
  def __kurt_preload_rows(rows : Array(T)) : Query(T)
    @preloaded = rows
    self
  end

  # An INNER JOIN for each association named, as the model declares it:
  # `Post.joins(:user, :comments)`. The rows are still posts, `posts.*`;
  # narrow by the joined table's columns with their table's name:
  # `where("users.name", "Ada")`. A has_many join gives a post once per
  # comment: add `distinct`.
  def joins(*names : Symbol) : Query(T)
    names.each { |name| join_association(name.to_s, "INNER") }
    self
  end

  # A LEFT OUTER JOIN: rows with no associated record too.
  def left_joins(*names : Symbol) : Query(T)
    names.each { |name| join_association(name.to_s, "LEFT OUTER") }
    self
  end

  # A join written out: `joins("INNER JOIN tags ON tags.id = taggings.tag_id")`.
  def joins(sql : String) : Query(T)
    @preloaded = nil
    (@joins ||= [] of String) << sql
    self
  end

  def join_association(name : String, kind : String) : Nil
    @preloaded = nil
    if sql = T.__kurt_join_sql(name, kind)
      (@joins ||= [] of String) << sql
    else
      @failure = T.model_name + " has no association " + name
    end
    nil
  end

  def joined? : Bool
    !@joins.nil?
  end

  # The columns to read instead of every one: `select("posts.*, users.name AS author")`.
  # `all` still makes models, so the selection has to give each field; for
  # other values, `pluck`.
  def select(*columns : Symbol | String) : Query(T)
    @preloaded = nil
    names = [] of String
    columns.each { |c| names << (c.is_a?(Symbol) ? mark_column(c.to_s) : c) }
    @select = names.join(", ")
    self
  end

  # SELECT DISTINCT.
  def distinct : Query(T)
    @preloaded = nil
    @distinct = true
    self
  end

  # GROUP BY: `group_by(:user_id)`; with `counts`, `sums`... for a value
  # per group. (Rails' `group`: in iyi, `group` is the task group.)
  def group_by(*columns : Symbol | String) : Query(T)
    @preloaded = nil
    list = @groups || [] of String
    columns.each { |c| list << (c.is_a?(Symbol) ? mark_column(c.to_s) : c) }
    @groups = list
    self
  end

  # HAVING, after `group_by`: `having("COUNT(*) > ?", [2])`.
  def having(fragment : String, args : Array(DBValue) = [] of DBValue) : Query(T)
    @preloaded = nil
    (@havings ||= [] of String) << "(" + fragment + ")"
    list = @having_args || [] of DBValue
    args.each { |arg| list << arg }
    @having_args = list
    self
  end

  # The rows of either query: `Post.where(published: true).or_where(Post.where(user_id: 5))`,
  # Rails' `.or` (in iyi, `.or` is the error recovery). Each side's
  # conditions stay together; joins, order and the rest are this query's.
  def or_where(other : Query(T)) : Query(T)
    @preloaded = nil
    mine = @wheres.empty? ? "1 = 1" : @wheres.join(" AND ")
    theirs = other.__kurt_wheres.empty? ? "1 = 1" : other.__kurt_wheres.join(" AND ")
    @wheres = ["((" + mine + ") OR (" + theirs + "))"]
    other.args.each { |arg| @args << arg }
    self
  end

  def __kurt_wheres : Array(String)
    @wheres
  end

  # `column IN (...)`; no values matches nothing.
  def where_in(column : String, values : Array(DBValue)) : Query(T)
    @preloaded = nil
    if values.empty?
      @wheres << "1 = 0"
    else
      @wheres << mark_column(column) + " IN (" + values.map { |_| "?" }.join(", ") + ")"
      values.each { |value| @args << value }
    end
    self
  end

  def where_in(column : Symbol, values : Array(DBValue)) : Query(T)
    where_in(column.to_s, values)
  end

  # Runs the query in *tx*: `Comment.where(post_id: 1).on(tx).all`. Nil is
  # no transaction, so a transaction that may or may not be there passes on.
  def on(tx : Transaction?) : Query(T)
    @on = tx
    self
  end

  # `column = value`; a nil value is `column IS NULL`.
  def where(column : String, value : DBValue) : Query(T)
    @preloaded = nil
    if value.nil?
      @wheres << mark_column(column) + " IS NULL"
    else
      @wheres << mark_column(column) + " = ?"
      @args << value
    end
    self
  end

  def where(column : Symbol, value : DBValue) : Query(T)
    where(column.to_s, value)
  end

  # `where(published: true, user_id: 5)`: each pair is `column = value`.
  def where(**conditions : **C) : Query(T) forall C
    conditions.each do |column, value|
      where(column.to_s, value.as(DBValue))
    end
    self
  end

  # A fragment of SQL with `?` placeholders: `where_sql("views > ?", [10])`.
  def where_sql(fragment : String, args : Array(DBValue) = [] of DBValue) : Query(T)
    @preloaded = nil
    @wheres << "(" + fragment + ")"
    args.each { |arg| @args << arg }
    self
  end

  def where_not(column : String, value : DBValue) : Query(T)
    @preloaded = nil
    if value.nil?
      @wheres << mark_column(column) + " IS NOT NULL"
    else
      @wheres << mark_column(column) + " <> ?"
      @args << value
    end
    self
  end

  def order(column : String) : Query(T)
    @preloaded = nil
    (@orders ||= [] of String) << mark_column(column) + " ASC"
    self
  end

  def order(column : Symbol) : Query(T)
    order(column.to_s)
  end

  def order_desc(column : String) : Query(T)
    @preloaded = nil
    (@orders ||= [] of String) << mark_column(column) + " DESC"
    self
  end

  def order_desc(column : Symbol) : Query(T)
    order_desc(column.to_s)
  end

  def limit(n : Int32) : Query(T)
    @preloaded = nil
    @limit = n
    self
  end

  def offset(n : Int32) : Query(T)
    @preloaded = nil
    @offset = n
    self
  end

  # Page 1 is the first; a page below 1 is page 1.
  # A page number as a request sends it: `paginate(params[:page])`. Missing
  # or not a number is page 1.
  def paginate(page : String?, per : Int32 = 25) : Query(T)
    paginate((page || "").strip.to_i? || 1, per)
  end

  def paginate(page : Int32, per : Int32 = 25) : Query(T)
    page = 1 if page < 1
    limit(per).offset((page - 1) * per)
  end

  # Marked column names as SQL: `posts.title` when the query joins, `title`
  # when it does not.
  def resolve(text : String) : String
    return text unless text.includes?(COLUMN_MARK)
    text.gsub(COLUMN_MARK, joined? ? T.table_name + "." : "")
  end

  # The WHERE clause, and the arguments it binds.
  def where_clause : String
    @wheres.empty? ? "" : " WHERE " + resolve(@wheres.join(" AND "))
  end

  # FROM, the joins and WHERE: what every statement of the query shares.
  def from_clause : String
    sql = " FROM " + T.table_name
    if joins = @joins
      sql += " " + joins.join(" ")
    end
    sql + where_clause
  end

  # GROUP BY and HAVING.
  def group_clause : String
    sql = ""
    if (groups = @groups) && !groups.empty?
      sql += " GROUP BY " + resolve(groups.join(", "))
    end
    if (havings = @havings) && !havings.empty?
      sql += " HAVING " + resolve(havings.join(" AND "))
    end
    sql
  end

  # ORDER BY, LIMIT and OFFSET.
  def tail_clause : String
    sql = ""
    if (orders = @orders) && !orders.empty?
      sql += " ORDER BY " + resolve(orders.join(", "))
    end
    if n = @limit
      sql += " LIMIT " + n.to_s
    end
    if n = @offset
      sql += " LIMIT -1" if @limit.nil? && !postgres?
      sql += " OFFSET " + n.to_s
    end
    sql
  end

  def select_list : String
    if chosen = @select
      resolve(chosen)
    else
      joined? ? T.table_name + ".*" : "*"
    end
  end

  def to_sql : String
    "SELECT " + (@distinct ? "DISTINCT " : "") + select_list + from_clause + group_clause + tail_clause
  end

  # The arguments the statement binds: the conditions', then HAVING's.
  def args : Array(DBValue)
    if extra = @having_args
      @args + extra
    else
      @args
    end
  end

  def failure : DBError?
    if message = @failure
      DBError.new(message)
    else
      nil
    end
  end

  # Every row the query matches.
  def all : Array(T) | DBError
    if loaded = @preloaded
      return loaded.dup
    end
    if failed = failure
      return failed
    end
    rows = if tx = @on
             tx.connection.query_all(placeholders(to_sql), args: args, as: T)!
           else
             database.query_all(placeholders(to_sql), args: args, as: T)!
           end
    if names = @includes
      names.each do |name|
        if failure = T.__kurt_preload(rows, name, @on)
          return failure
        end
      end
    end
    rows
  end

  # The first row, or NotFound when there is none.
  def first : T | NotFound | DBError
    if loaded = @preloaded
      return loaded.empty? ? NotFound.new(T.model_name) : loaded[0]
    end
    rows = limit(1).all!
    rows.empty? ? NotFound.new(T.model_name) : rows[0]
  end

  # The first row, or nil when there is none.
  def first? : T | Nil | DBError
    if loaded = @preloaded
      return loaded.empty? ? nil : loaded[0]
    end
    rows = limit(1).all!
    rows.empty? ? nil : rows[0]
  end

  # An id as a request sends it: `find(params[:id])`. Text that is not a
  # number finds nothing, without asking the database.
  def find(id : String) : T | NotFound | DBError
    number = id.strip.to_i64?
    number ? find(number) : NotFound.new(T.model_name)
  end

  def find(id : Int64) : T | NotFound | DBError
    where("id", id).first
  end

  # One value from the database: a COUNT, a SUM...
  def scalar(sql : String) : DBValue | DBError
    if failed = failure
      return failed
    end
    if tx = @on
      tx.connection.scalar(placeholders(sql), args: args)
    else
      database.scalar(placeholders(sql), args: args)
    end
  end

  def count : Int64 | DBError
    if loaded = @preloaded
      return loaded.size.to_i64
    end
    groups = @groups
    sql = if groups && !groups.empty?
            # One row per group: what the groups are, not every column.
            "SELECT COUNT(*) FROM (" + values_sql(groups.join(", ")) + ") AS kurt_counted"
          elsif @distinct || @select
            "SELECT COUNT(*) FROM (" + to_sql + ") AS kurt_counted"
          else
            "SELECT COUNT(*)" + from_clause
          end
    value = scalar(sql)!
    case value
    when Int64 then value
    when Int32 then value.to_i64
    else            0_i64
    end
  end

  def exists? : Bool | DBError
    count! > 0
  end

  # Deletes every row the query matches, without loading them; answers how
  # many went. With joins, the rows are chosen by their ids.
  def delete_all : Int64 | DBError
    if failed = failure
      return failed
    end
    sql = if joined?
            "DELETE FROM " + T.table_name + " WHERE id IN (SELECT " + T.table_name + ".id" + from_clause + ")"
          else
            "DELETE FROM " + T.table_name + where_clause
          end
    if tx = @on
      tx.connection.exec(placeholders(sql), args: @args)!.rows_affected
    else
      database.exec(placeholders(sql), args: @args)!.rows_affected
    end
  end

  # ---- values instead of models ---------------------------------------

  # The statement that reads *columns* instead of the rows.
  def values_sql(columns : String) : String
    "SELECT " + (@distinct ? "DISTINCT " : "") + resolve(columns) + from_clause + group_clause + tail_clause
  end

  def read_values(sql : String, width : Int32) : Array(Array(DBValue)) | DBError
    if failed = failure
      return failed
    end
    rows = [] of Array(DBValue)
    problem = nil
    reader = ->(rs : ::Db::Core::ResultSet) do
      row = [] of DBValue
      width.times do
        value = rs.read
        if value.is_a?(DBError)
          problem = value
          row << nil
        else
          row << value
        end
      end
      rows << row
      nil
    end
    if tx = @on
      tx.connection.query_each(placeholders(sql), args: args) { |rs| reader.call(rs) }!
    else
      database.query_each(placeholders(sql), args: args) { |rs| reader.call(rs) }!
    end
    if failed = problem
      return failed
    end
    rows
  end

  # One column's values: `Post.pluck(:title)!` is `Array(DBValue)`; with a
  # type, `Post.pluck(:title, String)!` is `Array(String)`. An expression
  # works too: `pluck("COUNT(*)")`.
  def pluck(column : Symbol | String) : Array(DBValue) | DBError
    name = column.is_a?(Symbol) ? mark_column(column.to_s) : column
    read_values(values_sql(name), 1)!.map { |row| row[0] }
  end

  def pluck(column : Symbol | String, type : K.class) : Array(K) | DBError forall K
    list = [] of K
    pluck(column)!.each do |value|
      converted = ::Kurt::Model.value_as(value, K)
      return DBError.new("pluck: " + column.to_s + " is not a " + K.to_s + ": " + value.inspect) if converted.is_a?(CastError)
      list << converted
    end
    list
  end

  # Several columns: one array of values per row.
  def pluck(*columns : Symbol | String) : Array(Array(DBValue)) | DBError
    names = [] of String
    columns.each { |c| names << (c.is_a?(Symbol) ? mark_column(c.to_s) : c) }
    read_values(values_sql(names.join(", ")), names.size)
  end

  # The ids: `Post.where(published: true).ids!`.
  def ids : Array(Int64) | DBError
    pluck(:id, Int64)
  end

  # ---- calculations ------------------------------------------------------

  def float_type : String
    postgres? ? "DOUBLE PRECISION" : "REAL"
  end

  # The sum of a column, 0.0 when no row matches: `Order.sum(:total)!`.
  # `sum(:quantity, Int64)` for a whole number.
  def sum(column : Symbol | String) : Float64 | DBError
    value = scalar(values_sql("CAST(COALESCE(SUM(" + column_sql(column) + "), 0) AS " + float_type + ")"))!
    ::Kurt::Model.number(value)
  end

  def sum(column : Symbol | String, type : Int64.class) : Int64 | DBError
    value = scalar(values_sql("CAST(COALESCE(SUM(" + column_sql(column) + "), 0) AS " + (postgres? ? "BIGINT" : "INTEGER") + ")"))!
    ::Kurt::Model.number(value).to_i64
  end

  # The mean, nil when no row matches.
  def average(column : Symbol | String) : Float64 | Nil | DBError
    value = scalar(values_sql("CAST(AVG(" + column_sql(column) + ") AS " + float_type + ")"))!
    value.nil? ? nil : ::Kurt::Model.number(value)
  end

  # The smallest value, nil when no row matches: `minimum(:price, Float64)`,
  # `minimum(:created_at, Time)`; without a type, the value as read.
  def minimum(column : Symbol | String) : DBValue | DBError
    scalar(values_sql("MIN(" + column_sql(column) + ")"))
  end

  def minimum(column : Symbol | String, type : K.class) : K | Nil | DBError forall K
    typed(minimum(column)!, K, "minimum")
  end

  def maximum(column : Symbol | String) : DBValue | DBError
    scalar(values_sql("MAX(" + column_sql(column) + ")"))
  end

  def maximum(column : Symbol | String, type : K.class) : K | Nil | DBError forall K
    typed(maximum(column)!, K, "maximum")
  end

  def typed(value : DBValue, type : K.class, what : String) : K | Nil | DBError forall K
    return nil if value.nil?
    converted = ::Kurt::Model.value_as(value, K)
    return DBError.new(what + ": not a " + K.to_s + ": " + value.inspect) if converted.is_a?(CastError)
    converted
  end

  def column_sql(column : Symbol | String) : String
    column.is_a?(Symbol) ? mark_column(column.to_s) : column
  end

  # ---- per group, after `group_by` -----------------------------------

  # The rows in each group: `Post.group_by(:user_id).counts!` is
  # `{1 => 3, 2 => 1}`, keyed by the group's value.
  def counts : Hash(DBValue, Int64) | DBError
    out = {} of DBValue => Int64
    grouped("COUNT(*)")!.each { |pair| out[pair[0]] = ::Kurt::Model.number(pair[1]).to_i64 }
    out
  end

  # The sum of *column* in each group.
  def sums(column : Symbol | String) : Hash(DBValue, Float64) | DBError
    out = {} of DBValue => Float64
    grouped("CAST(COALESCE(SUM(" + column_sql(column) + "), 0) AS " + float_type + ")")!.each { |pair| out[pair[0]] = ::Kurt::Model.number(pair[1]) }
    out
  end

  # The mean of *column* in each group.
  def averages(column : Symbol | String) : Hash(DBValue, Float64) | DBError
    out = {} of DBValue => Float64
    grouped("CAST(AVG(" + column_sql(column) + ") AS " + float_type + ")")!.each { |pair| out[pair[0]] = ::Kurt::Model.number(pair[1]) }
    out
  end

  def minimums(column : Symbol | String) : Hash(DBValue, DBValue) | DBError
    out = {} of DBValue => DBValue
    grouped("MIN(" + column_sql(column) + ")")!.each { |pair| out[pair[0]] = pair[1] }
    out
  end

  def maximums(column : Symbol | String) : Hash(DBValue, DBValue) | DBError
    out = {} of DBValue => DBValue
    grouped("MAX(" + column_sql(column) + ")")!.each { |pair| out[pair[0]] = pair[1] }
    out
  end

  # The group's value and *expression*, per group.
  def grouped(expression : String) : Array(Tuple(DBValue, DBValue)) | DBError
    groups = @groups
    return DBError.new("counts, sums...: call `group_by` first") if groups.nil? || groups.empty?
    rows = read_values(values_sql(groups.join(", ") + ", " + expression), groups.size + 1)!
    rows.map do |row|
      key = groups.size == 1 ? row[0] : row[0, groups.size].as(DBValue)
      {key, row[groups.size]}
    end
  end
end

# A number a calculation answered, as a Float64 (0.0 for NULL).
pub def number(value : DBValue) : Float64
  case value
  when Float64 then value
  when Float32 then value.to_f64
  when Int64   then value.to_f
  when Int32   then value.to_f
  when String  then value.to_f? || 0.0
  else              0.0
  end
end

# A value read from the database as *type*: the drivers answer an INTEGER
# as Int64 or Int32, a REAL as Float64, a SQLite date as text.
pub def value_as(value : DBValue, type : String.class) : String | CastError
  value.is_a?(String) ? value : CastError.new("not text")
end

pub def value_as(value : DBValue, type : Int64.class) : Int64 | CastError
  case value
  when Int64 then value
  when Int32 then value.to_i64
  else            CastError.new("not a whole number")
  end
end

pub def value_as(value : DBValue, type : Int32.class) : Int32 | CastError
  case value
  when Int32 then value
  when Int64 then value.to_i32
  else            CastError.new("not a whole number")
  end
end

pub def value_as(value : DBValue, type : Float64.class) : Float64 | CastError
  case value
  when Float64, Float32, Int64, Int32 then number(value)
  else                                     CastError.new("not a number")
  end
end

pub def value_as(value : DBValue, type : Bool.class) : Bool | CastError
  case value
  when Bool  then value
  when Int64 then value != 0
  when Int32 then value != 0
  else            CastError.new("not a Bool")
  end
end

pub def value_as(value : DBValue, type : Time.class) : Time | CastError
  case value
  when Time   then value
  when String then cast(value, Time)
  else             CastError.new("not a time")
  end
end

# A form value that is not of its field's type: "abc" for a number.
pub class CastError
  getter message : String

  def initialize(@message : String)
  end
end

# A form's text as a field's type, for `assign`.
pub def cast(raw : String, type : String.class) : String | CastError
  raw
end

pub def cast(raw : String, type : Int64.class) : Int64 | CastError
  text = raw.strip
  return CastError.new("can't be blank") if text.empty?
  text.to_i64? || CastError.new("is not a number")
end

pub def cast(raw : String, type : Int32.class) : Int32 | CastError
  text = raw.strip
  return CastError.new("can't be blank") if text.empty?
  text.to_i? || CastError.new("is not a number")
end

pub def cast(raw : String, type : Float64.class) : Float64 | CastError
  text = raw.strip
  return CastError.new("can't be blank") if text.empty?
  text.to_f? || CastError.new("is not a number")
end

# A checkbox sends "1" (with a hidden "0" before it), and nothing at all
# when it has no hidden field and is not ticked.
pub def cast(raw : String, type : Bool.class) : Bool | CastError
  case raw.strip.downcase
  when "1", "true", "on", "yes"     then true
  when "0", "false", "off", "no", "" then false
  else                                    CastError.new("is not true or false")
  end
end

# What a datetime-local or date input sends, and the database's own text.
pub def cast(raw : String, type : Time.class) : Time | CastError
  text = raw.strip
  return CastError.new("can't be blank") if text.empty?
  ["%Y-%m-%dT%H:%M:%S", "%Y-%m-%dT%H:%M", "%Y-%m-%d %H:%M:%S", "%Y-%m-%d"].each do |pattern|
    parsed = Time.parse_utc(text, pattern)
    return parsed if parsed.is_a?(Time)
  end
  CastError.new("is not a date")
end

# A value given to `new` as the field's type: an Int32 widens to Int64.
pub def coerce(value : Int32, type : Int64.class) : Int64
  value.to_i64
end

pub def coerce(value : Int64, type : Int64.class) : Int64
  value
end

# A field's value when `new` was not given one.
pub def zero_value(type : String.class) : String
  ""
end

pub def zero_value(type : Int64.class) : Int64
  0_i64
end

pub def zero_value(type : Int32.class) : Int32
  0
end

pub def zero_value(type : Float64.class) : Float64
  0.0
end

pub def zero_value(type : Bool.class) : Bool
  false
end

pub def zero_value(type : Time.class) : Time
  Time.utc
end

# What the methods `derive model` writes call. They run in the model's own
# module, which imports this one and nothing else of Kurt's, so every
# database call goes through here.

pub def now : Time
  Time.utc
end

# INSERT ... RETURNING id: the new row's id.
pub def insert_row(table : String, names : Array(String), values : Array(DBValue), on : Transaction? = nil) : Int64 | DBError
  marks = names.map { |_| "?" }
  sql = placeholders("INSERT INTO " + table + " (" + names.join(", ") + ") VALUES (" + marks.join(", ") + ") RETURNING id")
  if tx = on
    tx.connection.query_one(sql, args: values, as: Int64)
  else
    database.query_one(sql, args: values, as: Int64)
  end
end

pub def update_row(table : String, names : Array(String), values : Array(DBValue), id : Int64, on : Transaction? = nil) : Int64 | DBError
  sets = names.map { |name| name + " = ?" }
  args = values.dup
  args << id
  write_rows("UPDATE " + table + " SET " + sets.join(", ") + " WHERE id = ?", args, on)
end

pub def delete_row(table : String, id : Int64, on : Transaction? = nil) : Int64 | DBError
  args = [] of DBValue
  args << id
  write_rows("DELETE FROM " + table + " WHERE id = ?", args, on)
end

pub def increment_column(table : String, column : String, by : Int64, id : Int64, on : Transaction? = nil) : Int64 | DBError
  args = [] of DBValue
  args << by
  args << id
  write_rows("UPDATE " + table + " SET " + column + " = " + column + " + ? WHERE id = ?", args, on)
end

# ---------------------------------------------------------------------------
# Bulk writes: many rows in one statement, without models, validations or
# callbacks, as Rails' insert_all and upsert_all.
# ---------------------------------------------------------------------------

# The columns and values of *rows* (named tuples of one shape, or hashes
# with the same keys), with `created_at` and `updated_at` filled when the
# table has them and the rows do not.
def bulk_rows(rows : Array(R), columns : Array(String)) : Tuple(Array(String), Array(DBValue)) | DBError forall R
  names = [] of String
  values = [] of DBValue
  {% if R <= NamedTuple %}
    {% for key in R.keys %}
      names << {{ key.stringify }}
    {% end %}
  {% else %}
    rows[0].each_key { |key| names << key }
  {% end %}
  names.each do |name|
    return DBError.new("insert_all: no column " + name) unless columns.includes?(name) || name == "id"
  end
  stamps = ["created_at", "updated_at"].select { |c| columns.includes?(c) && !names.includes?(c) }
  now = Time.utc
  rows.each do |row|
    {% if R <= NamedTuple %}
      {% for key in R.keys %}
        values << row[{{ key.symbolize }}].as(DBValue)
      {% end %}
    {% else %}
      return DBError.new("insert_all: every row needs the same keys as the first") unless row.size == names.size
      names.each do |name|
        return DBError.new("insert_all: a row has no " + name) unless row.has_key?(name)
        values << row[name].as(DBValue)
      end
    {% end %}
    stamps.each { |_| values << now }
  end
  {names + stamps, values}
end

# INSERT ... VALUES (...), (...) RETURNING id: the ids of the rows written.
# *conflict* is the ON CONFLICT clause, or "".
def bulk_write(table : String, names : Array(String), values : Array(DBValue), conflict : String, on : Transaction?) : Array(Int64) | DBError
  marks = "(" + names.map { |_| "?" }.join(", ") + ")"
  count = names.empty? ? 0 : values.size // names.size
  sql = "INSERT INTO " + table + " (" + names.join(", ") + ") VALUES " + (Array.new(count) { marks }).join(", ") + conflict + " RETURNING id"
  if tx = on
    tx.connection.query_all(placeholders(sql), args: values, as: Int64)
  else
    database.query_all(placeholders(sql), args: values, as: Int64)
  end
end

pub def insert_all(table : String, columns : Array(String), rows : Array(R), skip_duplicates : Bool, on : Transaction?) : Array(Int64) | DBError forall R
  return [] of Int64 if rows.empty?
  names, values = bulk_rows(rows, columns)!
  bulk_write(table, names, values, skip_duplicates ? " ON CONFLICT DO NOTHING" : "", on)
end

pub def upsert_all(table : String, columns : Array(String), rows : Array(R), unique_by : Array(String), on : Transaction?) : Array(Int64) | DBError forall R
  return [] of Int64 if rows.empty?
  names, values = bulk_rows(rows, columns)!
  unique_by.each do |key|
    return DBError.new("upsert_all: unique_by " + key + " is not among the rows' columns") unless names.includes?(key)
  end
  # A row that is there already keeps its id and created_at, and takes the rest.
  changed = names.reject { |n| unique_by.includes?(n) || n == "id" || n == "created_at" }
  action = changed.empty? ? " DO NOTHING" : " DO UPDATE SET " + changed.map { |n| n + " = excluded." + n }.join(", ")
  bulk_write(table, names, values, " ON CONFLICT (" + unique_by.join(", ") + ")" + action, on)
end

# An UPDATE or DELETE, in *on* when there is one; how many rows it touched.
def write_rows(sql : String, args : Array(DBValue), on : Transaction?) : Int64 | DBError
  if tx = on
    tx.connection.exec(placeholders(sql), args: args)!.rows_affected
  else
    database.exec(placeholders(sql), args: args)!.rows_affected
  end
end

# ---------------------------------------------------------------------------
# Validations and callbacks, as in Rails, written in the class body:
#
#   class User < ApplicationRecord
#     validates :name, presence: true, length: {maximum: 60}
#     validates :email, presence: true, format: /\A[^@\s]+@[^@\s]+\z/, uniqueness: true
#     validates :role, inclusion: {in: ["admin", "member"]}
#
#     before_validation :normalize_email
#     after_create :send_welcome
#
#     def normalize_email
#       @email = email.strip.downcase
#     end
#   end
#
# Each `validates` and each callback line adds to the ones before it, in
# order. A `def validate(errors : Errors)` still runs, after them, for rules
# of your own. A callback that answers a DBError stops the save or destroy
# and hands the error up; any other answer is ignored.
# ---------------------------------------------------------------------------

# Blank: an empty or all-space string, nil, or a link column (`*_id`) that is
# still 0. A number, a time or false is there.
pub def blank?(field : String, value : String) : Bool
  value.strip.empty?
end

pub def blank?(field : String, value : Nil) : Bool
  true
end

pub def blank?(field : String, value : Int64 | Int32) : Bool
  field.ends_with?("_id") && value == 0
end

pub def blank?(field : String, value : Float64 | Bool | Time) : Bool
  false
end

pub def check_presence(errors : Errors, field : String, value : V, message : String?) : Nil forall V
  errors.add(field, message || "can't be blank") if blank?(field, value)
end

# Length of a string field; nil passes (a nilable column that is empty).
pub def check_length(errors : Errors, field : String, value : String?, minimum : Int32?, maximum : Int32?, exactly : Int32?, message : String?) : Nil
  return if value.nil?
  size = value.size
  if min = minimum
    errors.add(field, message || "is too short (minimum is " + min.to_s + " characters)") if size < min
  end
  if max = maximum
    errors.add(field, message || "is too long (maximum is " + max.to_s + " characters)") if size > max
  end
  if want = exactly
    errors.add(field, message || "is the wrong length (should be " + want.to_s + " characters)") if size != want
  end
end

pub def check_format(errors : Errors, field : String, value : String?, pattern : Regex, message : String?) : Nil
  return if value.nil?
  errors.add(field, message || "is invalid") unless value =~ pattern
end

pub def check_inclusion(errors : Errors, field : String, value : V, allowed : Array(A), message : String?) : Nil forall V, A
  errors.add(field, message || "is not included in the list") unless allowed.includes?(value)
end

# No other row has this value: a query to the database, so it can fail.
# Pair it with a unique index, which the database enforces under load.
pub def check_uniqueness(errors : Errors, field : String, others : Query(T), message : String?) : Nil | DBError forall T
  taken = others.exists?!
  errors.add(field, message || "has already been taken") if taken
  nil
end

# `validates :title, :body, presence: true` and the rest: presence, length
# ({minimum:, maximum:, is:, in: 3..20}), format (a regex), inclusion
# ({in: [...]}) and uniqueness (true). `message:` replaces every message of
# the line.
#
# Each line is a method of its own, named for its fields and the line it is
# on; `derive model` calls every one, in the order they were written. (A
# chain through `previous_def` lost the lines a macro wrote, `authentication`'s, to
# the lines written after it: a macro's methods are not among the type's
# yet when the next line's macro looks.)
pub macro validates(*fields, presence = nil, length = nil, format = nil, inclusion = nil, uniqueness = nil, message = nil)
  {% line = @caller ? @caller.first.line_number : 0 %}
  def __kurt_validations__{{ fields.map(&.id).join("__").id }}__l{{ line }}(errors : ::Kurt::Model::Errors) : ::Db::Errors::DBError?
    {% for field in fields %}
      {% name = field.id.stringify %}
      {% if presence %}
        ::Kurt::Model.check_presence(errors, {{ name }}, {{ field.id }}, {{ message }})
      {% end %}
      {% if length %}
        {% if length[:in] %}
          ::Kurt::Model.check_length(errors, {{ name }}, {{ field.id }}, {{ length[:in].begin }}, {{ length[:in].end }}, nil, {{ message }})
        {% else %}
          ::Kurt::Model.check_length(errors, {{ name }}, {{ field.id }}, {{ length[:minimum] }}, {{ length[:maximum] }}, {{ length[:is] }}, {{ message }})
        {% end %}
      {% end %}
      {% if format %}
        ::Kurt::Model.check_format(errors, {{ name }}, {{ field.id }}, {{ format.is_a?(NamedTupleLiteral) ? format[:with] : format }}, {{ message }})
      {% end %}
      {% if inclusion %}
        ::Kurt::Model.check_inclusion(errors, {{ name }}, {{ field.id }}, {{ inclusion.is_a?(NamedTupleLiteral) ? inclusion[:in] : inclusion }}, {{ message }})
      {% end %}
      {% if uniqueness %}
        if failure = ::Kurt::Model.check_uniqueness(errors, {{ name }}, self.class.query.on(@__kurt_on).where({{ name }}, {{ field.id }}).where_not("id", @id), {{ message }})
          return failure
        end
      {% end %}
    {% end %}
    nil
  end
end

# One callback line: a method of its own, named for the hook and the
# methods it calls; `derive model` calls every line of a hook in the order
# they were written (see `validates` for why not `previous_def`).
pub macro __kurt_callbacks(hook, names)
  def __kurt_{{ hook.id }}__{{ names.map(&.id).join("__").id }} : ::Db::Errors::DBError?
    {% for name in names %}
      result = {{ name.id }}
      return result if result.is_a?(::Db::Errors::DBError)
    {% end %}
    nil
  end
end

pub macro before_validation(*names)
  ::Kurt::Model.__kurt_callbacks(:before_validation, {{ names }})
end

pub macro before_save(*names)
  ::Kurt::Model.__kurt_callbacks(:before_save, {{ names }})
end

pub macro after_save(*names)
  ::Kurt::Model.__kurt_callbacks(:after_save, {{ names }})
end

pub macro before_create(*names)
  ::Kurt::Model.__kurt_callbacks(:before_create, {{ names }})
end

pub macro after_create(*names)
  ::Kurt::Model.__kurt_callbacks(:after_create, {{ names }})
end

pub macro before_update(*names)
  ::Kurt::Model.__kurt_callbacks(:before_update, {{ names }})
end

pub macro after_update(*names)
  ::Kurt::Model.__kurt_callbacks(:after_update, {{ names }})
end

pub macro before_destroy(*names)
  ::Kurt::Model.__kurt_callbacks(:before_destroy, {{ names }})
end

pub macro after_destroy(*names)
  ::Kurt::Model.__kurt_callbacks(:after_destroy, {{ names }})
end

# ---------------------------------------------------------------------------
# Passwords: `has_secure_password`, as in Rails, over a `password_digest`
# column. bcrypt, from std/password.
#
#   class User < ApplicationRecord
#     has_secure_password
#   end
#
#   user = User.create(email_address: "ada@example.com", password: "s3cret-pass", password_confirmation: "s3cret-pass")!
#   user.authenticate("s3cret-pass")                                   # true
#   User.authenticate_by("email_address", "ada@example.com", "s3cret-pass")!   # the user, or nil
# ---------------------------------------------------------------------------

# bcrypt's cost: the lowest in tests, where every user hashes a password.
pub def bcrypt_cost : Int32
  env == "test" ? 4 : 11
end

pub def digest_password(plain : String) : String
  Bcrypt.hash(plain, bcrypt_cost)
end

pub def verify_password(attempt : String, digest : String) : Bool
  return false if digest.empty?
  Bcrypt.verify(attempt, digest)
end

# What `authenticate_by` checks a password against when no record has the
# value, so that a miss takes as long as a wrong password.
DUMMY_DIGEST = "$2b$11$xIbZPOBwibM7ga01aso2t.tTpKxzprSE7YWt7sJ/ZxxJyVCPjfeUe"   # Bcrypt.hash("kurt: no such user", 11)

pub def dummy_digest : String
  DUMMY_DIGEST
end

# Rails' rules: required while there is no digest yet, at most 72 bytes
# (all bcrypt reads), and the confirmation, when one was given, the same.
pub def check_password(errors : Errors, password : String?, confirmation : String?, digest : String) : Nil
  if password.nil? || password.empty?
    errors.add("password", "can't be blank") if digest.empty?
    return
  end
  errors.add("password", "is too long (maximum is 72 bytes)") if password.bytesize > 72
  if confirmation && confirmation != password
    errors.add("password_confirmation", "doesn't match Password")
  end
end

pub macro has_secure_password
  @[::Db::Serializable::DBField(ignore: true)]
  @__kurt_password : String? = nil

  @[::Db::Serializable::DBField(ignore: true)]
  @__kurt_password_confirmation : String? = nil

  # The password being set: nil once it has been saved as the digest is
  # not; it is never read back from the database.
  def password : String?
    @__kurt_password
  end

  # An empty password is no password, as in Rails: an edit form left blank
  # keeps the old one.
  def password=(value : String?) : String?
    @__kurt_password = value && !value.empty? ? value : nil
  end

  def password_confirmation : String?
    @__kurt_password_confirmation
  end

  def password_confirmation=(value : String?) : String?
    @__kurt_password_confirmation = value
  end

  # `User.new(email_address: "...", password: "...")` and `User.create(...)`.
  def self.new(*, password : String, password_confirmation : String? = nil, **fields)
    record = new(**fields)
    record.password = password
    record.password_confirmation = password_confirmation
    record
  end

  # `user.update(password: "...", password_confirmation: "...")`.
  def update(*, password : String, password_confirmation : String? = nil, **fields)
    self.password = password
    @__kurt_password_confirmation = password_confirmation
    update(**fields)
  end

  def __kurt_password_checks(errors : ::Kurt::Model::Errors) : Nil
    ::Kurt::Model.check_password(errors, @__kurt_password, @__kurt_password_confirmation, password_digest)
  end

  # Turns a password that was set into the digest, just before the write.
  def __kurt_digest_password : Nil
    if plain = @__kurt_password
      @password_digest = ::Kurt::Model.digest_password(plain) unless plain.empty?
    end
    @__kurt_password = nil
    @__kurt_password_confirmation = nil
  end

  # A form's `password` and `password_confirmation`. Empty ones are kept as
  # they came: on an edit form, an empty password leaves the old one.
  def __kurt_assign_password(attributes : Hash(String, String)) : Nil
    if raw = attributes["password"]?
      self.password = raw
    end
    if raw = attributes["password_confirmation"]?
      @__kurt_password_confirmation = raw
    end
  end

  # True when *attempt* is this record's password.
  def authenticate(attempt : String) : Bool
    ::Kurt::Model.verify_password(attempt, password_digest)
  end

  # The record whose *column* is *value* and whose password *password* is;
  # nil otherwise. A miss checks a password too, so it takes as long.
  def self.authenticate_by(column : String, value : String, password : String) : self | Nil | ::Db::Errors::DBError
    if record = query.where(column, value).first?!
      return record.authenticate(password) ? record : nil
    end
    ::Kurt::Model.verify_password(password, ::Kurt::Model.dummy_digest)
    nil
  end
end

# Maps the class to its table. Writes, from the fields above it:
#
# * the row mapping (`db_serializable_non_strict`, so a column the class does
#   not declare is passed over);
# * `id`, unless the class declares it;
# * `new(**fields)` with every field optional;
# * class methods: `table_name`, `query`, `all`, `find`, `find?`, `first`,
#   `first?`, `count`, `where`, `order`, `order_desc`, `limit`, `paginate`,
#   `create`, `delete_all`, and one typed finder per field (`Post.title("Hi")`,
#   a wrong field name is a compile error);
# * instance methods: `save`, `destroy`, `persisted?`, `new_record?`, `valid?`,
#   `errors`, `attributes`.
#
# `created_at` and `updated_at` fields of type Time are stamped by `save`.
pub macro model(declaration)
  {% has_id = declaration[:fields].any? { |f| f[:name] == "@id" } %}
  {% unless has_id %}
    property id : Int64 = 0_i64
  {% end %}
  # A field named @__kurt_... is the framework's own (a password being set),
  # not a column.
  {% columns = declaration[:fields].reject { |f| f[:name] == "@id" || f[:name].starts_with?("@__kurt") } %}

  # The mapping reads the fields when it is typed, not from its argument; and
  # a class with no fields yet (its table not migrated) would hand it `[]`.
  ::Db::Serializable.db_serializable_with(nil, false)

  # What validation found last; not a column.
  @[::Db::Serializable::DBField(ignore: true)]
  @__kurt_errors : ::Kurt::Model::Errors? = nil

  # What the last `assign` could not convert; not a column.
  @[::Db::Serializable::DBField(ignore: true)]
  @__kurt_cast_errors : ::Kurt::Model::Errors? = nil

  # The transaction a save or destroy is running in, while it runs.
