# One `dependent:` link in the chain `destroy` runs before deleting the row.
pub macro __kurt_dependent(type, key, dependent, chained = false)
  {% unless dependent == :destroy || dependent == :delete_all %}
    {% raise "dependent: is :destroy or :delete_all, not " + dependent.stringify %}
  {% end %}
  def __kurt_dependents(on : ::Kurt::Model::Transaction?) : ::Db::Errors::DBError?
    {% if chained %}
      if failure = previous_def
        return failure
      end
    {% end %}
    {% if dependent == :delete_all %}
      {{ type }}.query.where({{ key }}, @id).on(on).delete_all!
    {% else %}
      {{ type }}.query.where({{ key }}, @id).on(on).all!.each do |child|
        gone = child.destroy(on: on)
        return gone if gone.is_a?(::Db::Errors::DBError)
      end
