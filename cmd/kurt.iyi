# ---------------------------------------------------------------------------
# css: Tailwind CSS (its standalone CLI, no Node) with daisyUI
# ---------------------------------------------------------------------------

TAILWIND_VERSION = "4.3.5"
DAISYUI_VERSION  = "5.8.2"
CSS_DIR    = "app/assets/tailwind"
CSS_INPUT  = CSS_DIR + "/app.css"
CSS_OUTPUT = "public/assets/app.css"
DAISYUI_FILES = ["daisyui.mjs", "daisyui-theme.mjs"]

# An application made with Tailwind (the default) has its input file.
def tailwind_app? : Bool
  File.exists?(CSS_INPUT)
end

# Where the Tailwind CLI is kept, once for every application.
def kurt_cache : String
  {% if flag?(:win32) %}
    if local = Program.env("LOCALAPPDATA")
      return local + "/kurt"
    end
  {% end %}
  base = Program.env("XDG_CACHE_HOME") || ((Program.env("HOME") || ".") + "/.cache")
  base + "/kurt"
end

def tailwind_binary : String
  kurt_cache + "/tailwindcss-v" + TAILWIND_VERSION + EXE
end

# The Tailwind release file for this machine: tailwindcss-macos-arm64 and
# the like.
def tailwind_asset : String?
  {% if flag?(:win32) %}
    # The one Windows build; an arm64 Windows runs it under x64 emulation.
    "tailwindcss-windows-x64.exe"
  {% else %}
    case result = Process.run("uname", ["-sm"])
    in ProcessResult
      parts = result.stdout.strip.split(" ")
      return nil unless result.success? && parts.size == 2
      os = parts[0] == "Darwin" ? "macos" : (parts[0] == "Linux" ? "linux" : "")
      arch = parts[1] == "arm64" || parts[1] == "aarch64" ? "arm64" : (parts[1] == "x86_64" ? "x64" : "")
      return nil if os.empty? || arch.empty?
      musl = os == "linux" && File.exists?("/etc/alpine-release") ? "-musl" : ""
      "tailwindcss-" + os + "-" + arch + musl
    in ProcessError, Cancelled
      nil
    end
  {% end %}
end

# Downloads *url* to *path* with curl; false, with the reason printed, when
# it could not.
def fetch(url : String, path : String) : Bool
  case result = Process.run("curl", ["-fsSL", "--retry", "2", "-o", path, url])
  in ProcessResult
    STDERR.puts "kurt: could not download " + url + ": " + result.stderr.strip unless result.success?
    result.success?
  in ProcessError
    STDERR.puts "kurt: could not run curl: " + result.message
    false
  in Cancelled
    false
  end
end

# The Tailwind CLI, downloaded on first use and checked against the
# release's sha256sums.txt; nil when it could not be had.
def ensure_tailwind : String?
  binary = tailwind_binary
  return binary if File.exists?(binary)
  asset = tailwind_asset
  if asset.nil?
    STDERR.puts "kurt: Tailwind has no standalone CLI for this machine; see https://tailwindcss.com/docs/installation"
    return nil
  end
  Dir.mkdir_p(kurt_cache) unless Dir.exists?(kurt_cache)
  base = "https://github.com/tailwindlabs/tailwindcss/releases/download/v" + TAILWIND_VERSION + "/"
  partial = binary + ".download"
  sums = binary + ".sha256sums"
  say("download", "Tailwind CSS v" + TAILWIND_VERSION + " (" + asset + ")")
  ok = fetch(base + asset, partial) && fetch(base + "sha256sums.txt", sums)
  if ok
    line = File.read(sums).lines.find { |l| l.strip.ends_with?(asset) }
    expected = line ? line.split(" ")[0] : ""
    if expected.empty? || SHA256.hexdigest(File.read(partial)) != expected
      STDERR.puts "kurt: the downloaded Tailwind CLI does not match its checksum; not using it"
      ok = false
    end
  end
  File.delete(sums) if File.exists?(sums)
  unless ok
    File.delete(partial) if File.exists?(partial)
    return nil
  end
  {% unless flag?(:win32) %}
    Process.run("chmod", ["+x", partial])
  {% end %}
  File.rename(partial, binary)
  say("create", binary)
  binary
end

# daisyUI's plugin files, next to the input file.
def ensure_daisyui : Bool
  base = "https://github.com/saadeghi/daisyui/releases/download/v" + DAISYUI_VERSION + "/"
  DAISYUI_FILES.all? do |file|
    path = CSS_DIR + "/" + file
    next true if File.exists?(path)
    Dir.mkdir_p(CSS_DIR) unless Dir.exists?(CSS_DIR)
    if fetch(base + file, path)
      say("create", path + " (daisyUI v" + DAISYUI_VERSION + ")")
      true
    else
      File.delete(path) if File.exists?(path)
      false
    end
  end
end

# Compiles app/assets/tailwind/app.css into public/assets/app.css. True in
# an application without Tailwind, which has nothing to build.
def build_css(minify : Bool = false) : Bool
  return true unless tailwind_app?
  binary = ensure_tailwind
  return false if binary.nil?
  return false unless ensure_daisyui
  args = ["-i", CSS_INPUT, "-o", CSS_OUTPUT]
  args << "--minify" if minify
  case result = Process.run(binary, args)
  in ProcessResult
    STDERR.puts "kurt: Tailwind could not build " + CSS_INPUT + ":\n" + result.stderr unless result.success?
    result.success?
  in ProcessError
    STDERR.puts "kurt: could not run " + binary + ": " + result.message
    false
  in Cancelled
    false
  end
end

def cmd_css(command : String, args : Array(String)) : Nil
  require_app
  fail("this application has no " + CSS_INPUT + " (it was made with --css none)") unless tailwind_app?
  if command == "css:install"
    fail("could not install the Tailwind CLI") if ensure_tailwind.nil?
    fail("could not install daisyUI") unless ensure_daisyui
    puts "kurt: Tailwind CSS v" + TAILWIND_VERSION + " and daisyUI v" + DAISYUI_VERSION + " are ready"
  else
    fail("the CSS did not build") unless build_css(args.includes?("--minify"))
    say("build", CSS_OUTPUT)
  end
end

def cmd_new(args : Array(String)) : Nil
  # `--css none` (or --css=none) leaves out Tailwind and daisyUI.
  css = "tailwind"
  names = [] of String
  i = 0
  while i < args.size
    arg = args[i]
    if arg == "--css"
      fail("--css needs a value: tailwind or none") if i + 1 >= args.size
      css = args[i + 1]
      i += 1
    elsif arg.starts_with?("--css=")
      css = arg[6, arg.size - 6]
    else
      names << arg
    end
    i += 1
  end
  fail("--css is tailwind or none, not `" + css + "`") unless css == "tailwind" || css == "none"
  daisy = css == "tailwind"
  fail("usage: kurt new NAME [--css tailwind|none]") if names.empty?
  dir = names[0]
  name = underscore(File.basename(dir)).gsub("-", "_")
  fail(dir + " already exists") if Dir.exists?(dir)
  fail("`" + name + "` is not a usable name: letters, digits and underscores, starting with a letter") unless name.size > 0 && name[0].ascii_letter? && name.chars.all? { |c| c.ascii_alphanumeric? || c == '_' }
  framework = framework_path
  css_pending = false
  Dir.mkdir_p(dir)
  Dir.cd(dir) do
    # The release this command is, unless KURT_PATH names a checkout.
    local = (Program.env("KURT_PATH") || "").presence
    write("iyi.mod", mod_file(name, local, VERSION))
    write("config/application.iyi", application_config(Random::Secure.hex(32)))
    write("config/routes.iyi", routes_file)
    write("app/models/.keep", "")
    write("app/controllers/application_controller.iyi", application_controller(daisy))
    write("app/controllers/home_controller.iyi", home_controller)
    write("app/views/layouts/application.eiy", layout_view(name, daisy))
    write("app/views/home/index.eiy", home_view(name, daisy))
    if daisy
      write(CSS_INPUT, tailwind_css)
    else
      write("public/assets/app.css", stylesheet)
    end
    if root = framework
      logo = root + "/kurt.svg"
      write("public/icon.svg", File.read(logo)) if File.exists?(logo)
    end
    write("db/migrations/.keep", "")
    write("test/fixtures/.keep", "")
    write("db/seeds.iyi", seeds_file)
    write(".gitignore", gitignore(daisy))
    write("AGENTS.md", agents_md(name))
    write("CLAUDE.md", claude_md)
    if daisy
      if build_css
        say("build", CSS_OUTPUT)
      else
        css_pending = true
      end
    end
  end
  puts ""
  puts "Created " + dir + ". Next:"
  puts "  cd " + dir
  puts "  kurt generate scaffold Post title:string body:text published:bool"
  puts "  kurt db:migrate"
  puts "  kurt dev"
  if css_pending
    puts ""
    puts "Tailwind CSS and daisyUI could not be downloaded; run `kurt css:install` when you are online."
  end
end

# ---------------------------------------------------------------------------
# generate
# ---------------------------------------------------------------------------

def migration_path(name : String) : String
  existing = Dir.exists?("db/migrations") ? Dir.entries("db/migrations") : [] of String
  stamp = timestamp(Time.utc).to_i64
  existing.each do |file|
    fail("a migration named " + name + " exists already: db/migrations/" + file) if file.ends_with?("_" + name + ".sql")
    # Two generated in the same second still sort, and never share a version.
    if version = file.split("_")[0].to_i64?
      stamp = version + 1 if version >= stamp
    end
  end
  "db/migrations/" + stamp.to_s + "_" + name + ".sql"
end

def add_route(line : String) : Nil
  update("config/routes.iyi", append_route(File.read("config/routes.iyi"), line))
end

def add_nav(names : Names) : Nil
  path = "app/views/layouts/application.eiy"
  return unless File.exists?(path)
  source = File.read(path)
  link = nav_link(names, tailwind_app?)
  return if source.includes?(link)
  update(path, source.sub("<!-- kurt:nav -->", link + "<!-- kurt:nav -->"))
end

def model_path(model : String) : String
  "app/models/" + underscore(model) + ".iyi"
end

def gen_model(names : Names, fields : Array(Field)) : Nil
  path = model_path(names.model)
  fail(names.model + " exists already: " + path) if File.exists?(path)
  known = [] of String
  fields.each do |field|
    next unless field.reference?
    target = camelize(field.name)
    target_path = model_path(target)
    if File.exists?(target_path)
      known << target
      update(target_path, add_has_many(File.read(target_path), names))
    end
  end
  write(path, model_file(names, fields, known))
  write(migration_path("create_" + names.plural), create_table_migration(names, fields, postgres_url?(database_url)))
end

# The first text column a `create_<table>` migration declares, if any.
def migration_label(table : String) : String?
  return nil unless Dir.exists?("db/migrations")
  file = Dir.entries("db/migrations").find { |f| f.ends_with?("_create_" + table + ".sql") }
  return nil if file.nil?
  File.read("db/migrations/" + file).lines.each do |line|
    parts = line.strip.split(" ")
    next if parts.size < 2 || parts[0] == "id" || parts[0] == "--"
    type = parts[1].upcase
    return parts[0] if type.starts_with?("TEXT") || type.starts_with?("VARCHAR")
  end
  nil
end

# For each referenced model that has a file: the column a form's select
# and the pages show it by, its first text column in db/schema.json (a
# User by its name, a Post by its title), or its id.
def reference_labels(fields : Array(Field)) : Hash(String, String)
  labels = {} of String => String
  tables = read_schema
  fields.each do |field|
    next unless field.reference?
    target = camelize(field.name)
    next unless File.exists?(model_path(target))
    table_name = pluralize(underscore(target))
    label = "id"
    if table = find(tables, table_name)
      if column = table.columns.find { |c| c.type == "String" && c.name != "id" }
        label = column.name
      end
    else
      # Not migrated yet: its create migration says what it will have.
      label = migration_label(table_name) || "id"
    end
    labels[target] = label
  end
  labels
end

def gen_scaffold(app : String, names : Names, fields : Array(Field)) : Nil
  labels = reference_labels(fields)
  gen_model(names, fields)
  write(names.controller_file, scaffold_controller(names, fields, labels))
  base = "app/views/" + names.plural + "/"
  daisy = tailwind_app?
  write(base + "index.eiy", index_view(names, fields, labels, daisy))
  write(base + "show.eiy", show_view(names, fields, labels, daisy))
  write(base + "new.eiy", new_view(names, daisy))
  write(base + "edit.eiy", edit_view(names, daisy))
  write(base + "_form.eiy", form_view(names, fields, labels, daisy))
  # An application made before form_with: its forms get daisyUI's classes.
  if daisy && (line = form_style_line(File.read("app/controllers/application_controller.iyi")))
    insert_after_line("app/controllers/application_controller.iyi", "class ApplicationController", line)
  end
  if daisy && (css = with_form_classes(File.read(CSS_INPUT)))
    update(CSS_INPUT, css)
  end
  add_route("resources \"" + names.plural + "\", " + names.controller)
  add_nav(names)
  ensure_attachments_table if fields.any?(&.attachment?)
  test = scaffold_test(app, names, fields.reject(&.attachment?))
  write("test/" + names.plural + "_test.iyi", test)
end

def gen_controller(name : String, actions : Array(String)) : Nil
  actions = ["index"] if actions.empty?
  plural = underscore(name).sub("_controller", "")
  klass = camelize(plural) + "Controller"
  write("app/controllers/" + plural + "_controller.iyi", plain_controller(plural, actions))
  actions.each { |action| write("app/views/" + plural + "/" + action + ".eiy", plain_view(plural, action, tailwind_app?)) }
  actions.each do |action|
    path = "/" + plural + (action == "index" ? "" : "/" + action)
    add_route("get \"" + path + "\", " + klass + ", :" + action)
  end
end

# A mailer, a text and an HTML view per method, the mailer layouts, and a
# test.
def gen_mailer(name : String, methods : Array(String)) : Nil
  methods = ["welcome"] if methods.empty?
  file = mailer_file_name(name)
  write("app/mailers/application_mailer.iyi", application_mailer) unless File.exists?("app/mailers/application_mailer.iyi")
  path = "app/mailers/" + file + ".iyi"
  fail(camelize(file) + " exists already: " + path) if File.exists?(path)
  write(path, mailer_class(name, methods))
  methods.each do |method|
    write("app/views/" + file + "/" + method + ".text.eiy", mailer_text_view(name, method))
    write("app/views/" + file + "/" + method + ".html.eiy", mailer_html_view(name, method))
  end
  write("app/views/layouts/mailer.html.eiy", mailer_layout_html) unless File.exists?("app/views/layouts/mailer.html.eiy")
  write("app/views/layouts/mailer.text.eiy", mailer_layout_text) unless File.exists?("app/views/layouts/mailer.text.eiy")
  write("test/" + file + "_test.iyi", mailer_test(name, methods))
end

# A job, ApplicationJob, a test, and the queue's migration when no
# migration makes it yet.
def gen_job(name : String) : Nil
  write("app/jobs/application_job.iyi", application_job) unless File.exists?("app/jobs/application_job.iyi")
  path = "app/jobs/" + job_file_name(name) + ".iyi"
  fail(camelize(job_file_name(name)) + " exists already: " + path) if File.exists?(path)
  write(path, job_class(name))
  write("test/" + job_file_name(name) + "_test.iyi", job_test(name))
  ensure_jobs_table
end

# Whether a migration creates *table*.
def migration_makes?(table : String) : Bool
  return false unless Dir.exists?("db/migrations")
  Dir.entries("db/migrations").any? { |f| f.ends_with?(".sql") && File.read("db/migrations/" + f).includes?("CREATE TABLE " + table + " ") }
end

# The kurt_jobs migration, unless one is there.
def ensure_jobs_table : Nil
  return if migration_makes?("kurt_jobs")
  write(migration_path("create_kurt_jobs"), jobs_migration(postgres_url?(database_url)))
end

# The kurt_attachments migration, unless one is there; storage/ out of git.
def ensure_attachments_table : Nil
  unless migration_makes?("kurt_attachments")
    write(migration_path("create_kurt_attachments"), attachments_migration(postgres_url?(database_url)))
  end
  if File.exists?(".gitignore") && !File.read(".gitignore").includes?("/storage/")
    update(".gitignore", File.read(".gitignore").rstrip + "\n/storage/\n")
  end
end

# ---------------------------------------------------------------------------
# generate authentication
# ---------------------------------------------------------------------------

def insert_after_line(path : String, line_start : String, text : String) : Bool
  return false unless File.exists?(path)
  source = File.read(path)
  lines = source.lines
  index = lines.index { |l| l.starts_with?(line_start) }
  return false if index.nil?
  # Set apart from what follows by a blank line.
  update(path, (lines[0, index + 1] + [text.rstrip + "\n"] + lines[index + 1, lines.size - index - 1]).join("\n") + "\n")
  true
end

# Before the class's last `end`.
def insert_before_last_end(path : String, text : String) : Bool
  return false unless File.exists?(path)
  source = File.read(path).rstrip
  return false unless source.ends_with?("end")
  update(path, source[0, source.size - 3] + text + "end\n")
  true
end

# Authentication for User: `authentication :...` in the model, the
# columns, `authentication_for "users"`, `authentication_helpers User`, the layout's links,
# the mail layouts and a test. *extra* names modules beyond the
# defaults (confirmation, lock, tracking, timeout). Kurt ships the
# controllers and views; `authentication:views` and `authentication:controllers` copy them.
def gen_authentication(app : String, extra : Array(String)) : Nil
  extra.each do |name|
    fail("`" + name + "` is not one of " + OPTIONAL_MODULES.join(", ")) unless OPTIONAL_MODULES.includes?(name)
  end
  modules = DEFAULT_MODULES + extra
  daisy = tailwind_app?
  model_file = "app/models/user.iyi"
  if File.exists?(model_file)
    model = File.read(model_file)
    fail(model_file + " has `authentication` already") if auth_modules_of(model)
    insert_after_line(model_file, "class User", auth_model_line(modules))
    existing = [] of String
    if table = find(read_schema, "users")
      existing = table.columns.map(&.name)
    else
      fail("migrate first: the users table is not in " + SCHEMA)
    end
    write(migration_path("add_authentication_to_users"), auth_columns_migration("email", existing, postgres_url?(database_url)))
    users_scaffold_takes_passwords(daisy)
    users_test_takes_passwords
  else
    write(model_file, auth_model(modules))
    write(migration_path("create_users"), auth_users_migration("email", postgres_url?(database_url)))
  end
  # A users scaffold has POST /users already, which signing up would be.
  routes = File.read("config/routes.iyi")
  base = routes.includes?("resources \"users\"") ? "auth" : nil
  # What sign-up asks for besides the address: the other text columns.
  fields = [] of String
  if table = find(read_schema, "users")
    skip = AUTH_COLUMNS + ["id", "email", "created_at", "updated_at"]
    table.columns.each { |c| fields << c.name if c.type == "String" && !skip.includes?(c.name) }
  end
  scope = AuthScope.new("users", modules, "email", fields, base)
  add_route(auth_for_line(scope))
  controller = "app/controllers/application_controller.iyi"
  unless File.read(controller).includes?("authentication_helpers")
    insert_after_line(controller, "class ApplicationController", "  # current_user, user_signed_in?, authenticate_user!, sign_in, sign_out\n" + auth_helpers_line(scope))
  end
  write("app/mailers/application_mailer.iyi", application_mailer) unless File.exists?("app/mailers/application_mailer.iyi")
  write("app/views/layouts/mailer.html.eiy", mailer_layout_html) unless File.exists?("app/views/layouts/mailer.html.eiy")
  write("app/views/layouts/mailer.text.eiy", mailer_layout_text) unless File.exists?("app/views/layouts/mailer.text.eiy")
  layout = "app/views/layouts/application.eiy"
  if File.exists?(layout) && !File.read(layout).includes?("user_signed_in?")
    update(layout, File.read(layout).sub("<!-- kurt:nav -->", "<!-- kurt:nav -->" + auth_nav(scope, daisy)))
  end
  write("test/authentication_test.iyi", auth_test(scope))
  if daisy && (css = with_auth_classes(File.read(CSS_INPUT)))
    update(CSS_INPUT, css)
  end

  puts ""
  puts "Authentication is in: " + modules.join(", ") + ". Next:"
  puts "  kurt db:migrate"
  puts "  kurt dev        # " + scope.path + "/sign_up, " + scope.path + "/sign_in"
  puts ""
  puts "A page that needs a signed-in user: `before_action :authenticate_user!` in its controller"
  puts "(or in ApplicationController, for every page). To change the pages:"
  puts "  kurt generate authentication:views          # app/views/authentication/"
  puts "  kurt generate authentication:controllers    # app/controllers/user_*_controller.iyi"
end

# `kurt generate authentication:views`: Kurt's sign-in, sign-up, password and mail
# views into app/views/authentication/, where the build uses them instead.
def gen_auth_views : Nil
  scopes = auth_scopes(read_schema)
  fail("no authentication_for in config/routes.iyi: run `kurt generate authentication` first") if scopes.empty?
  key = scopes[0].key
  daisy = tailwind_app?
  auth_view_names.each { |name| write("app/views/authentication/" + name + ".eiy", auth_view(name, key, daisy)) }
  auth_mail_names.each do |name|
    write("app/views/authentication/mailer/" + name + ".text.eiy", auth_mail_view(name, key, false))
    write("app/views/authentication/mailer/" + name + ".html.eiy", auth_mail_view(name, key, true))
  end
end

# `kurt generate authentication:controllers [users]`: the scope's controllers and
# mailer into the application, rendering app/views/authentication/ (copied too).
def gen_auth_controllers(plural : String?) : Nil
  scopes = auth_scopes(read_schema)
  fail("no authentication_for in config/routes.iyi: run `kurt generate authentication` first") if scopes.empty?
  scope = plural ? (scopes.find { |s| s.plural == plural } || fail("no authentication_for \"" + plural + "\" in config/routes.iyi")) : scopes[0]
  gen_auth_views
  scope.kinds.each { |kind| write("app/controllers/" + scope.controller_file(kind), auth_controller(kind, scope)) }
  if scope.mails?
    parent = File.exists?("app/mailers/application_mailer.iyi") ? "ApplicationMailer" : "Mailer"
    write("app/mailers/" + scope.mailer_file, auth_mailer(scope, parent))
  end
end

# A users scaffold made before: its form and its permit list take a password.
def users_scaffold_takes_passwords(daisy : Bool) : Nil
  controller = "app/controllers/users_controller.iyi"
  if File.exists?(controller)
    source = File.read(controller)
    unless source.includes?(":password")
      update(controller, source.sub(/params\.require\(:user\)\.permit\(([^)]*)\)/) { |m| m[0, m.size - 1] + ", :password, :password_confirmation)" })
    end
  end
  form = "app/views/users/_form.eiy"
  if File.exists?(form)
    source = File.read(form)
    unless source.includes?("user[password]") || source.includes?("f.password_field")
      inputs = auth_input("password", "Password", "password", "maxlength: 72, autocomplete: \"new-password\"", daisy) +
               auth_input("password_confirmation", "Password confirmation", "password", "autocomplete: \"new-password\"", daisy)
      marker = daisy ? "    <div class=\"card-actions" : "  <div class=\"actions\">"
      if source.includes?("form_with") && source.includes?(marker)
        update(form, source.sub(marker, inputs + marker))
      else
        STDERR.puts "kurt: add password and password_confirmation fields to " + form + " yourself"
      end
    end
  end
end

# A users scaffold's test: a user now needs a password.
def users_test_takes_passwords : Nil
  path = "test/users_test.iyi"
  return unless File.exists?(path)
  source = File.read(path)
  return if source.includes?("user%5Bpassword%5D")
  source = source.gsub(/form_request\("POST", "\/users", "([^"]*)"\)/) { |m| m[0, m.size - 2] + "&user%5Bpassword%5D=" + AUTH_TEST_PASSWORD + "&user%5Bpassword_confirmation%5D=" + AUTH_TEST_PASSWORD + "\")" }
  update(path, source)
end

def cmd_generate(args : Array(String)) : Nil
  fail("usage: kurt generate (scaffold|model|controller|migration|mailer|job) NAME ..., or kurt generate authentication") if args.empty?
  kind = args[0]
  app = require_app
  case kind
  when "attachments"
    ensure_attachments_table
    return
  when "authentication"
    gen_authentication(app, args[1, args.size - 1])
    return
  when "authentication:views"
    gen_auth_views
    return
  when "authentication:controllers"
    gen_auth_controllers(args[1]?)
    return
  end
  fail("usage: kurt generate (scaffold|model|controller|migration) NAME ...") if args.size < 2
  name = args[1]
  rest = args[2, args.size - 2]
  case kind
  when "scaffold", "resource"
    fields = parse_fields(rest)
    fail(fields) if fields.is_a?(String)
    gen_scaffold(app, Names.new(name), fields)
  when "model"
    fields = parse_fields(rest)
    fail(fields) if fields.is_a?(String)
    gen_model(Names.new(name), fields)
  when "controller"
    gen_controller(name, rest)
  when "migration"
    write(migration_path(underscore(name)), empty_migration)
  when "mailer"
    gen_mailer(name, rest)
  when "job"
    gen_job(name)
  else
    fail("unknown generator `" + kind + "`: scaffold, model, controller, migration or mailer")
  end
end

# ---------------------------------------------------------------------------
# db
# ---------------------------------------------------------------------------

def open_database : Database
  url = database_url
  if url.starts_with?("sqlite3:./")
    dir = File.dirname(url[8, url.size - 8].split("?")[0])
    Dir.mkdir_p(dir) unless Dir.exists?(dir)
  end
  case opened = Db.open(url)
  in Database then opened
  in DBError  then fail("cannot open " + url + ": " + opened.message)
  end
end

def report(result : Array(Migration) | MigrationError | DBError, verb : String) : Nil
  case result
  in Array(Migration)
    puts result.empty? ? "nothing to " + verb : ""
    result.each { |m| puts "  " + verb.rjust(8) + "  " + m.label }
  in MigrationError, DBError
    fail(result.message)
  end
end

SCHEMA = "db/schema.json"

def read_schema : Array(Table)
  File.exists?(SCHEMA) ? parse(File.read(SCHEMA)) : [] of Table
end

# Reads the tables back from the database into db/schema.json, then puts
# each model's columns in the comment at the top of its file.
def dump_schema(database : Database) : Nil
  tables = case found = introspect(database, database_url)
           in Array(Table) then found
           in DBError      then fail("reading the schema: " + found.message)
           end
  json = to_json(tables)
  if !File.exists?(SCHEMA) || File.read(SCHEMA) != json
    File.write(SCHEMA, json)
    say("dump", SCHEMA)
  end
  sources("app/models").each do |source|
    path = "app/models/" + File.basename(source.path)
    annotated = annotate(source.text, tables)
    update(path, annotated) unless annotated == source.text
  end
end

def cmd_migrate : Nil
  app_name
  database = open_database
  report(migrate(database, database_url, "db/migrations"), "migrate")
  dump_schema(database)
end

def cmd_rollback(args : Array(String)) : Nil
  app_name
  steps = args.empty? ? 1 : (args[0].to_i? || fail("STEPS is a number"))
  database = open_database
  report(rollback(database, database_url, "db/migrations", steps), "rollback")
  dump_schema(database)
end

def cmd_status : Nil
  app_name
  case rows = status(open_database, "db/migrations")
  in Array(Tuple(Migration, Bool))
    puts "nothing in db/migrations" if rows.empty?
    rows.each { |row| puts (row[1] ? "  up    " : "  down  ") + row[0].label }
  in MigrationError, DBError
    fail(rows.message)
  end
end

def sqlite_file(url : String) : String?
  return nil unless url.starts_with?("sqlite3:./")
  url[8, url.size - 8].split("?")[0]
end

def cmd_reset : Nil
  app_name
  file = sqlite_file(database_url)
  fail("db:reset drops SQLite files only; drop " + database_url + " yourself") if file.nil?
  [file, file + "-wal", file + "-shm"].each do |path|
    if File.exists?(path)
      File.delete(path)
      say("remove", path)
    end
  end
  cmd_migrate
  cmd_seed if File.exists?("db/seeds.iyi")
end

# db/seeds.iyi: the rows a new database starts with, written with the
# models. Run it again and again: `find_or_create_by` makes it safe to.
def cmd_seed : Nil
  name = require_app
  seeds = source?("db/seeds.iyi") || fail("no db/seeds.iyi")
  build_app(name)
  emit(BUILD + "/seeds.iyi", seeds_module(seeds))
  exec_iyi(["run", BUILD + "/seeds.iyi"])
end

# test/fixtures/<table>.yml, each file one table's rows; read at build
# time so a mistake in one stops `kurt test` before anything runs.
def read_fixtures : Array(FixtureSet)
  case sets = read_fixture_sets
  in Array(FixtureSet) then sets
  in String            then fail(sets)
  end
end

# ---------------------------------------------------------------------------
# dev, test
# ---------------------------------------------------------------------------

BUILD = ".kurt/build"

def sources(dir : String) : Array(Source)
  return [] of Source unless Dir.exists?(dir)
  root = Dir.current
  Dir.entries(dir).select { |f| f.ends_with?(".iyi") }.sorted.map do |file|
    path = dir + "/" + file
    Source.new(root + "/" + path, File.read(path))
  end
end

def source?(path : String) : Source?
  File.exists?(path) ? Source.new(Dir.current + "/" + path, File.read(path)) : nil
end

# Writes *contents* only when it changed, so iyi's cache keeps what did not.
def emit(path : String, contents : String) : Nil
  dir = File.dirname(path)
  Dir.mkdir_p(dir) unless Dir.exists?(dir)
  return if File.exists?(path) && File.read(path) == contents
  File.write(path, contents)
end

# The application's files, as the modules iyi compiles, in .kurt/build.
# Answers the entry file's path.
def build_app(name : String, tests : Bool = false) : String
  root = Dir.current
  mod = File.read("iyi.mod").lines.map do |line|
    stripped = line.strip
    # A relative `replace` is relative to the application, not to the build.
    if stripped.starts_with?("replace ") && stripped.includes?("=> ")
      target = stripped[stripped.index("=> ").as(Int32) + 3, stripped.size].strip
      target.starts_with?("/") ? line : stripped[0, stripped.index("=> ").as(Int32) + 3] + root + "/" + target
    else
      line
    end
  end
  emit(BUILD + "/iyi.mod", mod.join("\n") + "\n")
  emit(BUILD + "/iyi.sum", File.read("iyi.sum")) if File.exists?("iyi.sum")
  generated = root + "/" + BUILD
  models = sources("app/models")
  tables = read_schema
  missing = missing_tables(models, tables)
  unless missing.empty?
    STDERR.puts "kurt: no table in " + SCHEMA + " for " + missing.join(", ") + ": run `kurt db:migrate` (a model's fields come from its table)"
  end
  emit(BUILD + "/app/models.iyi", models_module(models, tables, root + "/" + SCHEMA))
  model_names = [] of String
  models.each { |source| model_tables(source.text).each { |pair| model_names << pair[0] } }
  auth_controllers, auth_mailers = auth_sources(tables)
  emit(BUILD + "/app/mailers.iyi", mailers_module(sources("app/mailers") + auth_mailers, model_names))
  emit(BUILD + "/app/jobs.iyi", jobs_module(sources("app/jobs"), model_names))
  emit(BUILD + "/app/controllers.iyi", controllers_module(sources("app/controllers") + auth_controllers, model_names))
  routes = source?("config/routes.iyi") || fail("no config/routes.iyi")
  emit(BUILD + "/app/routes.iyi", routes_module(routes, generated + "/app/routes.iyi", migration_makes?("kurt_attachments")))
  entry = BUILD + "/" + name + ".iyi"
  migrations = [] of Tuple(String, String)
  if Dir.exists?("db/migrations")
    Dir.entries("db/migrations").select { |f| f.ends_with?(".sql") }.sorted.each do |file|
      migrations << {"db/migrations/" + file, File.read("db/migrations/" + file)}
    end
  end
  emit(entry, entry_module(name, source?("config/application.iyi"), generated + "/" + name + ".iyi", migrations))
  # Tests from an earlier build that no longer have a file go.
  Dir.entries(BUILD).each do |file|
    File.delete(BUILD + "/" + file) if file.ends_with?("_test.iyi") && !File.exists?("test/" + file)
  end
  if tests
    model_pairs = [] of Tuple(String, String)
    models.each { |source| model_tables(source.text).each { |pair| model_pairs << pair } }
    emit(BUILD + "/app/fixtures.iyi", fixtures_module(read_fixtures, model_pairs, root + "/test/fixtures", root + "/" + SCHEMA))
    sources("test").each do |source|
      next unless source.path.ends_with?("_test.iyi")
      file = File.basename(source.path)
      emit(BUILD + "/" + file, test_module(file[0, file.size - 4], source))
    end
  end
  entry
end

# ---------------------------------------------------------------------------
# Authentication: what Kurt ships for each `authentication_for` scope
# ---------------------------------------------------------------------------

# Each `authentication_for "users"` scope in config/routes.iyi, with its model's
# modules, its sign-in column and the text columns sign-up asks for.
def auth_scopes(tables : Array(Table)) : Array(AuthScope)
  return [] of AuthScope unless File.exists?("config/routes.iyi")
  found = [] of AuthScope
  auth_for_scopes(File.read("config/routes.iyi")).each do |pair|
    plural, base = pair
    model = model_path(camelize(singularize(plural)))
    fail("authentication_for \"" + plural + "\": no " + model) unless File.exists?(model)
    text = File.read(model)
    modules = auth_modules_of(text) || fail("authentication_for \"" + plural + "\": " + model + " has no `authentication :password, ...` line")
    key = auth_key_of(text)
    fields = [] of String
    if table = find(tables, plural)
      skip = AUTH_COLUMNS + ["id", key, "created_at", "updated_at"]
      table.columns.each { |c| fields << c.name if c.type == "String" && !skip.includes?(c.name) }
    end
    found << AuthScope.new(plural, modules, key, fields, base)
  end
  found
end

AUTH_BUILD = BUILD + "/authentication"

# The controllers, routes and mailer of every scope, as sources for the
# controllers and mailers modules: the application's own copies where it
# has them (app/controllers/user_sessions_controller.iyi...), Kurt's
# otherwise. Kurt's are written into .kurt/build/authentication/, with their views
# there too unless app/views/authentication/ has the application's.
def auth_sources(tables : Array(Table)) : Tuple(Array(Source), Array(Source))
  controllers = [] of Source
  mailers = [] of Source
  scopes = auth_scopes(tables)
  # Controllers written for a build before, which the application now has
  # its own copy of (or no scope needs), go.
  if Dir.exists?(AUTH_BUILD)
    Dir.entries(AUTH_BUILD).each do |file|
      File.delete(AUTH_BUILD + "/" + file) if file.ends_with?(".iyi")
    end
  end
  return {controllers, mailers} if scopes.empty?
  root = Dir.current
  daisy = tailwind_app?
  scopes.each do |scope|
    paths = {"layout" => root + "/app/views/layouts/application.eiy"}
    auth_view_names.each do |name|
      own = "app/views/authentication/" + name + ".eiy"
      if File.exists?(own)
        paths[name] = root + "/" + own
      else
        shipped = AUTH_BUILD + "/views/" + daisy.to_s + "/" + scope.key + "/" + name + ".eiy"
        emit(shipped, auth_view(name, scope.key, daisy))
        paths[name] = root + "/" + shipped
      end
    end
    scope.kinds.each do |kind|
      next if File.exists?("app/controllers/" + scope.controller_file(kind))
      file = AUTH_BUILD + "/" + scope.controller_file(kind)
      text = auth_controller(kind, scope, paths)
      emit(file, text)
      controllers << Source.new(root + "/" + file, text)
    end
    routes = AUTH_BUILD + "/" + scope.plural + "_routes.iyi"
    text = auth_routes_source(scope)
    emit(routes, text)
    controllers << Source.new(root + "/" + routes, text)
    next unless scope.mails? && !File.exists?("app/mailers/" + scope.mailer_file)
    mail_paths = {"layout" => File.exists?("app/views/layouts/mailer.text.eiy") || File.exists?("app/views/layouts/mailer.html.eiy") ? root + "/app/views/layouts/mailer" : ""}
    auth_mail_names.each do |name|
      own = "app/views/authentication/mailer/" + name
      if File.exists?(own + ".text.eiy") || File.exists?(own + ".html.eiy")
        mail_paths["mailer/" + name] = root + "/" + own
      else
        shipped = AUTH_BUILD + "/views/mail/" + scope.key + "/" + name
        emit(shipped + ".text.eiy", auth_mail_view(name, scope.key, false))
        emit(shipped + ".html.eiy", auth_mail_view(name, scope.key, true))
        mail_paths["mailer/" + name] = root + "/" + shipped
      end
    end
    parent = File.exists?("app/mailers/application_mailer.iyi") ? "ApplicationMailer" : "Mailer"
    file = AUTH_BUILD + "/" + scope.mailer_file
    text = auth_mailer(scope, parent, mail_paths)
    emit(file, text)
    mailers << Source.new(root + "/" + file, text)
  end
  {controllers, mailers}
end

def exec_iyi(args : Array(String), env : Hash(String, String)? = nil) : NoReturn
  failure = Process.exec("iyi", args, env: env)
  fail("could not start iyi: " + failure.message + " (is ~/.local/bin on PATH?)")
end

# What `kurt dev` watches: the application's code, views, settings and
# schema. public/ is served from disk as it is, so it needs no restart.
WATCHED = ["app", "config", "db/schema.json", "iyi.mod"]

# Every watched file with its modification time.
def snapshot : Hash(String, Int64)
  found = {} of String => Int64
  WATCHED.each { |path| collect(path, found) }
  found
end

def collect(path : String, found : Hash(String, Int64)) : Nil
  if Dir.exists?(path)
    Dir.entries(path).each do |entry|
      next if entry.starts_with?(".")
      collect(path + "/" + entry, found)
    end
  elsif File.exists?(path)
    found[path] = File.info(path).modification_time
  end
end

# What changed between two snapshots, for the log line.
def changes(before : Hash(String, Int64), after : Hash(String, Int64)) : Array(String)
  changed = [] of String
  after.each { |path, time| changed << path if before[path]? != time }
  before.each_key { |path| changed << path unless after.has_key?(path) }
  changed
end

# Compiles the application into *output*; false when it does not build,
# with iyi's errors already printed.
def compile(name : String, output : String) : Bool
  entry = build_app(name)
  Dir.mkdir_p(File.dirname(output)) unless Dir.exists?(File.dirname(output))
  started = Time.utc.to_unix_ms
  case result = Process.run("iyi", ["build", entry, "-o", output], capture: false)
  in ProcessResult
    if result.success?
      took = Time.utc.to_unix_ms - started
      puts "kurt: built in " + (took // 1000).to_s + "." + (took % 1000 // 100).to_s + "s"
      true
    else
      STDERR.puts "kurt: the build failed; the running server, if any, is the last one that built"
      false
    end
  in ProcessError
    fail("could not start iyi: " + result.message + " (is ~/.local/bin on PATH?)")
  in Cancelled
    false
  end
end

def start_server(binary : String, args : Array(String)) : ChildProcess?
  env = {"KURT_LIVE_RELOAD" => "1"}
  # Links in mail lead to this server unless APP_URL says otherwise.
  if (Program.env("APP_URL") || "").empty?
    at = args.index("-p") || args.index("--port")
    port = at ? (args[at + 1]? || "3000") : "3000"
    env["APP_URL"] = "http://localhost:" + port
  end
  case child = Process.spawn(binary, args, env: env)
  in ChildProcess  then child
  in ProcessError
    STDERR.puts "kurt: could not start " + binary + ": " + child.message
    nil
  end
end

# Asks the server to stop, and stops it if it has not after half a second:
# a stopping iyi-web server waits for the requests it is serving, and a
# page's live-reload stream is one of them.
def stop_server(server : ChildProcess?) : Nil
  return if server.nil?
  return if server.ended?
  server.terminate
  10.times do
    break if server.ended?
    sleep(50)
  end
  server.kill unless server.ended?
  server.wait
  nil
end

# Runs the application, and builds and restarts it whenever a watched file
# changes. A change that does not build leaves the last good server
# running. Pages reload themselves when their server restarts.
def cmd_dev(args : Array(String)) : Nil
  name = require_app
  if args.includes?("--no-reload")
    exec_iyi(["run", build_app(name), "--"] + args.reject { |a| a == "--no-reload" })
  end
  binary = ".kurt/bin/" + name + EXE
  fresh = ".kurt/bin/" + name + ".next" + EXE
  seen = snapshot
  build_css
  server = compile(name, binary) ? start_server(binary, args) : nil
  puts "kurt: watching app/, config/ and db/schema.json; Ctrl+C stops"
  group do |g|
    # However kurt dev is stopped (Ctrl+C, a kill, a closed terminal),
    # the server it started stops with it rather than holding the port.
    g.spawn(unit: :same) do
      # Windows' console has INT (Ctrl+C) and TERM (closed, log off), no HUP.
      {% if flag?(:win32) %}
        Signal.wait(Signal::INT, Signal::TERM)
      {% else %}
        Signal.wait(Signal::INT, Signal::TERM, Signal::HUP)
      {% end %}
      stop_server(server)
      exit 0
    end
    loop do
      sleep(400)
      now = snapshot
      next if now == seen
      # Editors write in several steps; let the last one land.
      sleep(200)
      now = snapshot
      changes(seen, now).each { |path| say("change", path) }
      seen = now
      # The views a change touched may use classes the CSS does not have yet.
      build_css
      next unless compile(name, fresh)
      stop_server(server)
      File.rename(fresh, binary)
      File.rename(debug_info(fresh), debug_info(binary)) if File.exists?(debug_info(fresh))
      server = start_server(binary, args)
    end
  end
end

def cmd_build(args : Array(String)) : Nil
  name = require_app
  fail("the CSS did not build") unless build_css(minify: true)
  entry = build_app(name)
  Dir.mkdir_p("bin") unless Dir.exists?("bin")
  exec_iyi(["build", "--release", entry, "-o", "bin/" + name] + args)
end

# Every route the application has, from its own router: what resources
# registered for the actions its controllers define, nested ones and
# namespaces with their full paths.
def cmd_routes : Nil
  name = require_app
  exec_iyi(["run", build_app(name)], {"KURT_PRINT_ROUTES" => "1"})
end

# The worker alone, from the application's own binary: `kurt jobs` here,
# `./bin/app jobs` on a server.
def cmd_jobs : Nil
  name = require_app
  entry = build_app(name)
  fail("no kurt_jobs table among the migrations: `kurt generate job NAME` writes its migration") unless File.read(entry).includes?("Program.args[0]? == \"jobs\"")
  exec_iyi(["run", entry, "--", "jobs"])
end

def cmd_test(args : Array(String)) : Nil
  name = require_app
  build_app(name, tests: true)
  env = {"KURT_ENV" => "test", "IYI_WEB_ENV" => "test"}
  url = Program.env("DATABASE_URL") || "sqlite3:./db/test.sqlite3"
  env["DATABASE_URL"] = url
  if file = sqlite_file(url)
    [file, file + "-wal", file + "-shm"].each { |path| File.delete(path) if File.exists?(path) }
  end
  Dir.mkdir_p("db") unless Dir.exists?("db")
  database = case opened = Db.open(url)
             in Database then opened
             in DBError  then fail("cannot open " + url + ": " + opened.message)
             end
  case ran = migrate(database, url, "db/migrations")
  in Array(Migration) then nil
  in MigrationError, DBError then fail("migrating the test database: " + ran.message)
  end
  database.close
  exec_iyi(["test", BUILD, "-p", "1"] + args, env)
end

# ---------------------------------------------------------------------------
# export: the application as static files
# ---------------------------------------------------------------------------

# The file `kurt export` leaves in its directory, so that a later export
# may empty that directory and no other.
EXPORT_MARK = ".kurt-export"

# Runs a tool and says whether it succeeded.
def run_tool(command : String, args : Array(String)) : Bool
  case result = Process.run(command, args)
  in ProcessResult
    STDERR.puts "kurt: " + command + " failed: " + result.stderr.strip unless result.success?
    result.success?
  in ProcessError
    STDERR.puts "kurt: could not run " + command + ": " + result.message
    false
  in Cancelled
    false
  end
end

# Fetches *url* into *path* with curl: the status code ("000" when nothing
# answered) and the content type.
def fetch_page(url : String, path : String) : Tuple(String, String)
  case result = Process.run("curl", ["-s", "-o", path, "-w", "%{http_code} %{content_type}", url])
  in ProcessResult
    words = result.stdout.strip.split(" ")
    {words[0]? || "000", words[1]? || ""}
  in ProcessError
    fail("could not run curl: " + result.message)
  in Cancelled
    {"000", ""}
  end
end

# Builds the application, runs it on a local port, and writes what it
# serves to *dir*: every GET route without parameters, the local pages
# those link to, the paths given, and public/. A static host (GitHub Pages,
# Netlify, any web server) then serves *dir* as the site.
def cmd_export(args : Array(String)) : Nil
  name = require_app
  dir = "dist"
  extra = [] of String
  i = 0
  while i < args.size
    arg = args[i]
    if arg == "-o" || arg == "--output"
      dir = args[i + 1]? || fail("-o needs a directory")
      i += 2
    elsif arg.starts_with?("/")
      extra << arg
      i += 1
    else
      fail("kurt export [-o DIR] [PATH...]: a PATH starts with / (" + arg + ")")
    end
  end
  if Dir.exists?(dir) && !Dir.children(dir).empty? && !File.exists?(dir + "/" + EXPORT_MARK)
    fail(dir + " is not empty and kurt export did not write it; name another directory")
  end
  fail("the CSS did not build") unless build_css(minify: true)
  binary = ".kurt/bin/" + name + "-export" + EXE
  fail("the application does not build") unless compile(name, binary)

  routes = case listed = Process.run(binary, [] of String, env: {"KURT_PRINT_ROUTES" => "1"})
           in ProcessResult then listed.stdout
           in ProcessError  then fail("could not run " + binary + ": " + listed.message)
           in Cancelled     then ""
           end

  run_tool("rm", ["-rf", dir]) if Dir.exists?(dir)
  Dir.mkdir_p(dir)
  File.write(dir + "/" + EXPORT_MARK, "Written by kurt export; the next export empties this directory.\n")
  if Dir.exists?("public")
    fail("could not copy public/") unless run_tool("cp", ["-R", "public/.", dir + "/"])
  end

  port = 20000 + Random.rand(20000)
  base = "http://127.0.0.1:" + port.to_s
  server = case started = Process.spawn(binary, ["-b", "127.0.0.1", "-p", port.to_s], output: Redirect::Null, error: Redirect::Null)
           in ChildProcess then started
           in ProcessError then fail("could not start " + binary + ": " + started.message)
           end
  up = false
  100.times do
    break if up
    up = fetch_page(base + "/", "/dev/null")[0] != "000"
    sleep(100) unless up
  end
  unless up
    stop_server(server)
    fail("the application did not start on " + base + " (try `kurt dev` to see why)")
  end

  queue = get_paths(routes)
  extra.each { |path| queue << path unless queue.includes?(path) }
  seen = queue.dup
  part = dir + "/" + EXPORT_MARK + ".part"
  pages = 0
  skipped = 0
  i = 0
  while i < queue.size
    path = queue[i]
    i += 1
    status, type = fetch_page(base + path, part)
    unless status == "200"
      say("skip", path + " (" + status + ")")
      skipped += 1
      next
    end
    file = dir + "/" + output_file(path)
    Dir.mkdir_p(File.dirname(file)) unless Dir.exists?(File.dirname(file))
    File.rename(part, file)
    say("export", file)
    pages += 1
    next unless type.starts_with?("text/html")
    local_links(File.read(file)).each do |link|
      next if seen.includes?(link)
      seen << link
      # public/ is copied as it is.
      next if File.file?("public" + link)
      queue << link
    end
  end
  File.delete(part) if File.exists?(part)
  stop_server(server)
  File.delete(binary) if File.exists?(binary)
  File.delete(debug_info(binary)) if File.exists?(debug_info(binary))
  puts "kurt: " + pages.to_s + " pages in " + dir + "/" + (skipped > 0 ? ", " + skipped.to_s + " skipped" : "") +
       (Dir.exists?("public") ? ", with public/" : "")
end

# ---------------------------------------------------------------------------

args = Program.args
command = args.empty? ? "help" : args[0]
rest = args.size > 1 ? args[1, args.size - 1] : [] of String

case command
when "new"                       then cmd_new(rest)
when "generate", "g"             then cmd_generate(rest)
when "db:migrate"                then cmd_migrate
when "db:rollback"               then cmd_rollback(rest)
when "db:status"                 then cmd_status
when "db:reset"                  then cmd_reset
when "db:seed"                   then cmd_seed
when "dev", "server", "s"        then cmd_dev(rest)
when "test"                      then cmd_test(rest)
when "build"                     then cmd_build(rest)
when "export"                    then cmd_export(rest)
when "css:install", "css:build"  then cmd_css(command, rest)
when "routes"                    then cmd_routes
when "jobs"                      then cmd_jobs
when "version", "--version", "-v" then puts "kurt " + VERSION
when "help", "--help", "-h"      then puts USAGE
else
  STDERR.puts USAGE
  fail("unknown command `" + command + "`")
end
