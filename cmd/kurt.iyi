VERSION = ::Kurt::Version::VERSION

# What iyi writes for `-o NAME`: NAME.exe and NAME.pdb on Windows (given
# the .exe, which a NAME with a dot in it is not given), NAME and
# NAME.dwarf elsewhere.
{% if flag?(:win32) %}
  EXE = ".exe"
  DEBUG_INFO = ".pdb"
{% else %}
  EXE = ""
  DEBUG_INFO = ".dwarf"
{% end %}

def debug_info(executable : String) : String
  executable[0, executable.size - EXE.size] + DEBUG_INFO
end

USAGE = <<-TEXT
kurt #{VERSION}: an MVC web framework for iyi

Usage:
  kurt new NAME [--css none]             a new application in ./NAME, with Tailwind CSS
                                         and daisyUI unless --css none
  kurt generate scaffold NAME FIELD...   model, migration, controller, views, routes, test
  kurt generate model NAME FIELD...      model and migration
  kurt generate controller NAME ACTION...
  kurt generate migration NAME
  kurt generate mailer NAME METHOD...    a mailer, its text and HTML views, a test
  kurt generate job NAME                 a background job, a test, the queue's table
  kurt generate attachments              the table has_one_attached keeps files in
  kurt generate authentication [MODULE...]
                                         users: sign-in, sign-up, password reset,
                                         remember me; MODULE adds confirmation,
                                         lock, tracking or timeout
  kurt generate authentication:views     the sign-in and other views, to change them
  kurt generate authentication:controllers
                                         the authentication controllers, to change them
  kurt db:migrate                        run pending migrations
  kurt db:rollback [STEPS]               undo the last migration(s)
  kurt db:status                         which migrations have run
  kurt db:reset                          drop the SQLite database, migrate, seed
  kurt db:seed                           run db/seeds.iyi
  kurt dev [-p PORT] [--no-reload]       run the application; rebuild and reload on change
  kurt routes                            every route: verb, path, controller#action
  kurt jobs                              run the background jobs worker on its own
  kurt test                              run every test/*_test.iyi on a fresh test database,
                                         with test/fixtures/*.yml loaded
  kurt build                             a release binary in bin/NAME
  kurt export [-o DIR] [PATH...]         the application as static files in DIR (dist):
                                         every GET page without parameters, the pages
                                         they link to, each PATH, and public/
  kurt css:build [--minify]              compile app/assets/tailwind/app.css
  kurt css:install                       download the Tailwind CLI and daisyUI
  kurt version

FIELD is name:type, with type one of string, text, int, float, bool, time,
references, attachment. `g` is short for generate.

The database is DATABASE_URL, or sqlite3:./db/<env>.sqlite3 with env from
KURT_ENV (development by default).
TEXT

def fail(message : String) : NoReturn
  STDERR.puts "kurt: " + message
  exit 1
end

def say(action : String, path : String) : Nil
  puts "  " + action.rjust(8) + "  " + path
end

def write(path : String, contents : String) : Nil
  if File.exists?(path)
    say("exists", path)
    return
  end
  dir = File.dirname(path)
  Dir.mkdir_p(dir) unless dir.empty? || Dir.exists?(dir)
  File.write(path, contents.empty? || contents.ends_with?("\n") ? contents : contents + "\n")
  say("create", path)
end

def update(path : String, contents : String) : Nil
  return if File.read(path) == contents
  File.write(path, contents)
  say("update", path)
end

# The Kurt checkout this binary was built from: bin/kurt's parent, or
# KURT_PATH. A symlink to bin/kurt (~/.local/bin/kurt, say) is followed to
# the checkout it points into.
def framework_path : String?
  if path = Program.env("KURT_PATH")
    return path unless path.empty?
  end
  if exe = Process.executable
    root = File.dirname(File.dirname(File.real_path(exe)))
    return root if File.exists?(root + "/model.iyi") && File.exists?(root + "/cmd/kurt/generators.iyi")
  end
  nil
end

# The application's name, from its iyi.mod.
def app_name : String
  fail("not in a Kurt application: no iyi.mod here") unless File.exists?("iyi.mod")
  File.read("iyi.mod").lines.each do |line|
    stripped = line.strip
    return stripped[7, stripped.size - 7].strip if stripped.starts_with?("module ")
  end
  fail("iyi.mod names no module")
end

def require_app : String
  name = app_name
  fail("not in a Kurt application: no config/routes.iyi") unless File.exists?("config/routes.iyi")
  name
end

