module test/fixtures_test

import std/text
import std/time::{Time}
import std/password::{Bcrypt}
import db/db/errors::{DBError}
import datasource::{database, postgres?}
import schema::{Table, Column}
import fixtures::*

def run : Nil | DBError
  db = database
  id = postgres? ? "BIGSERIAL PRIMARY KEY" : "INTEGER PRIMARY KEY"
  int = postgres? ? "BIGINT" : "INTEGER"
  bool = postgres? ? "BOOLEAN NOT NULL DEFAULT FALSE" : "INTEGER NOT NULL DEFAULT 0"
  stamp = postgres? ? "TIMESTAMP" : "TEXT"
  ["authors", "books"].each { |t| db.exec("DROP TABLE IF EXISTS " + t)! }
  db.exec("CREATE TABLE authors (id " + id + ", name TEXT NOT NULL, email TEXT NOT NULL, admin " + bool + ", password_digest TEXT NOT NULL DEFAULT '', created_at " + stamp + ", updated_at " + stamp + ")")!
  db.exec("CREATE TABLE books (id " + id + ", title TEXT NOT NULL, price " + int + ", author_id " + int + " NOT NULL, published_at " + stamp + ")")!
  tables = [
    Table.new("authors", [Column.new("id", "", "Int64"), Column.new("name", "", "String"), Column.new("email", "", "String"),
                          Column.new("admin", "", "Bool"), Column.new("password_digest", "", "String"),
                          Column.new("created_at", "", "Time"), Column.new("updated_at", "", "Time")]),
    Table.new("books", [Column.new("id", "", "Int64"), Column.new("title", "", "String"), Column.new("price", "", "Int64"),
                        Column.new("author_id", "", "Int64"), Column.new("published_at", "", "Time?")]),
    Table.new("members", [Column.new("id", "", "Int64"), Column.new("email", "", "String"), Column.new("encrypted_password", "", "String")]),
  ]

  # ids: the same every run, below 2^30, different per label
  assert fixture_id("ada") == fixture_id("ada")
  assert fixture_id("ada") != fixture_id("bob")
  assert fixture_id("ada") > 0 && fixture_id("ada") <= 1073741823

  sets = read_fixture_sets("test/fixtures/yaml").as(Array(FixtureSet))
  assert sets.map(&.table) == ["authors", "books"]
  assert sets[0].labels == ["ada", "bob"]
  assert read_fixture_sets("test/fixtures/nothing-here").as(Array(FixtureSet)).empty?

  rows = fixture_rows(sets[1], tables).as(Array(FixtureRow))
  assert rows[0].columns == ["id", "title", "price", "author_id", "published_at"]
  assert rows[0].values[1] == "1984"                       # a number in a text column is its text
  assert rows[0].values[3] == fixture_id("ada")            # author: ada
  authors = fixture_rows(sets[0], tables).as(Array(FixtureRow))
  assert authors[0].columns.includes?("password_digest")   # password: becomes a digest
  assert !authors[0].columns.includes?("password")
  assert authors[0].columns.includes?("created_at")        # timestamps filled in
  assert rows[0].values[4].is_a?(Time)                      # a column that allows NULL converts too
  members = fixture_rows(parse_fixtures("members", "members.yml", "ada:\n  email: a@b.c\n  password: secret123\n").as(FixtureSet), tables).as(Array(FixtureRow))
  assert members[0].columns == ["id", "email", "encrypted_password"]   # Devise's column

  # what is wrong is said, with the file and the label
  bad = parse_fixtures("books", "books.yml", "x:\n  nope: 1\n").as(FixtureSet)
  assert fixture_rows(bad, tables) == "books.yml: x: no column nope in books"
  wrong = parse_fixtures("books", "books.yml", "x:\n  price: lots\n").as(FixtureSet)
  assert fixture_rows(wrong, tables) == "books.yml: x: price is not a Int64: lots"
  assert fixture_rows(FixtureSet.new("ghosts", "ghosts.yml", [] of Fixture), tables) == "ghosts.yml: no table ghosts in db/schema.json (run `kurt db:migrate`)"
  assert parse_fixtures("books", "books.yml", "- a\n- b\n") == "books.yml: a mapping of labels to rows"
  assert parse_fixtures("books", "books.yml", "bad label:\n  title: x\n") == "books.yml: label bad label is not a name (letters, digits and _)"
  assert parse_fixtures("books", "books.yml", "").as(FixtureSet).fixtures.empty?

  # loaded over what was there, twice: the same rows
  db.exec(postgres? ? "INSERT INTO books (title, author_id) VALUES ($1, $2)" : "INSERT INTO books (title, author_id) VALUES (?, ?)", "stale", 1_i64)!
  2.times do
    loaded = reload_fixtures(db, postgres?, tables, "test/fixtures/yaml")
    assert loaded.nil?
  end
  assert db.scalar("SELECT COUNT(*) FROM books").as(Int64) == 2
  assert db.query_one("SELECT name FROM authors WHERE id = " + fixture_id("bob").to_s, as: String).as(String) == "Bob: the second"
  digest = db.query_one("SELECT password_digest FROM authors WHERE id = " + fixture_id("ada").to_s, as: String).as(String)
  assert Bcrypt.verify("secret123", digest)
  admin = db.query_one("SELECT admin FROM authors WHERE id = " + fixture_id("ada").to_s, as: Bool).as(Bool)
  assert admin
  # a new row after the fixtures gets an id of its own (PostgreSQL's sequence moved)
  db.exec(postgres? ? "INSERT INTO books (title, author_id) VALUES ($1, $2)" : "INSERT INTO books (title, author_id) VALUES (?, ?)", "new", 1_i64)!
  newest = db.scalar("SELECT MAX(id) FROM books").as(Int64)
  assert newest > fixture_id("first") && newest > fixture_id("second")
  ["authors", "books"].each { |t| db.exec("DROP TABLE " + t)! }
  puts "fixtures: all assertions passed" + (postgres? ? " (postgres)" : " (sqlite)")
  nil
end

case failure = run
in Nil then nil
in DBError then raise failure.message
end
