module test/helpers_test

import std/text
import std/time::{Time}
import helpers::*

assert truncate("Hello world", length: 8) == "Hello..."
assert truncate("Short", length: 8) == "Short"
assert pluralize(1, "comment") == "1 comment"
assert pluralize(3, "comment") == "3 comments"
assert pluralize(2, "person") == "2 people"
assert pluralize(2, "octopus", "octopodes") == "2 octopodes"
assert number_with_delimiter(1234567) == "1,234,567"
assert number_with_delimiter(-1234) == "-1,234"
assert number_with_delimiter(999) == "999"
assert number_with_delimiter(1234567, ".") == "1.234.567"

now = Time.utc
assert time_ago_in_words(now - Time::Span.new(seconds: 10), now) == "less than a minute"
assert time_ago_in_words(now - Time::Span.new(minutes: 5), now) == "5 minutes"
assert time_ago_in_words(now - Time::Span.new(minutes: 50), now) == "about 1 hour"
assert time_ago_in_words(now - Time::Span.new(hours: 3), now) == "about 3 hours"
assert time_ago_in_words(now - Time::Span.new(hours: 30), now) == "1 day"
assert time_ago_in_words(now - Time::Span.new(days: 6), now) == "6 days"
assert time_ago_in_words(now - Time::Span.new(days: 45), now) == "about 1 month"
assert time_ago_in_words(now - Time::Span.new(days: 100), now) == "3 months"
assert time_ago_in_words(now - Time::Span.new(days: 400), now) == "about 1 year"
assert time_ago_in_words(now - Time::Span.new(days: 600), now) == "over 1 year"

assert simple_format("One\ntwo\n\nThree <b>").to_s == "<p>One<br>\ntwo</p>\n<p>Three &lt;b&gt;</p>"
assert simple_format("").to_s == ""
assert attributes_html(class: "btn", disabled: true, hidden: false, data_turbo: false, title: nil) == %( class="btn" disabled data-turbo="false")

puts "helpers: all assertions passed"
