# Names, the way the conventions need them: `Post` -> `posts`,
# `BlogPost` -> `blog_post`, `posts` -> `PostsController`. English rules
# only, and only the common ones; a model with an irregular table name says
# so with `@[Table("people")]`.
module inflector

import std/text


# A function rather than a table: routes on every core call `pluralize`,
# and a constant Hash is mutable state they may not reach.
def irregular_plural(word : String) : String?
  case word
  when "person" then "people"
  when "man"    then "men"
  when "woman"  then "women"
  when "child"  then "children"
  when "mouse"  then "mice"
  when "goose"  then "geese"
  when "foot"   then "feet"
  when "tooth"  then "teeth"
  else               nil
  end
end

pub def pluralize(word : String) : String
  return word if word.empty?
  if plural = irregular_plural(word)
    return plural
  end
  if word.ends_with?("y") && word.size > 1 && !"aeiou".includes?(word[word.size - 2].to_s)
    return word[0, word.size - 1] + "ies"
  end
  if word.ends_with?("s") || word.ends_with?("x") || word.ends_with?("z") || word.ends_with?("ch") || word.ends_with?("sh")
    return word + "es"
  end
  word + "s"
end

pub def singularize(word : String) : String
  ["person", "man", "woman", "child", "mouse", "goose", "foot", "tooth"].each do |singular|
    return singular if irregular_plural(singular) == word
  end
  if word.ends_with?("ies") && word.size > 3
    return word[0, word.size - 3] + "y"
  end
  ["ches", "shes", "sses", "xes", "zes"].each do |ending|
    return word[0, word.size - 2] if word.ends_with?(ending)
  end
  if word.ends_with?("s") && !word.ends_with?("ss")
    return word[0, word.size - 1]
  end
  word
end

# `BlogPost` -> `blog_post`.
pub def underscore(word : String) : String
  out = ""
  i = 0
  while i < word.size
    c = word[i]
    if c.ascii_uppercase?
      out += "_" if i > 0 && (word[i - 1].ascii_lowercase? || word[i - 1].ascii_number?)
      out += c.downcase.to_s
    else
      out += c.to_s
    end
    i += 1
  end
  out
end

# `blog_post` -> `BlogPost`.
pub def camelize(word : String) : String
  out = ""
  upper = true
  word.each_char do |c|
    if c == '_' || c == '-'
      upper = true
    elsif upper
      out += c.upcase.to_s
      upper = false
    else
      out += c.to_s
    end
  end
  out
end

# `post_id` -> `Post id`, for labels and messages.
pub def humanize(word : String) : String
  text = word.ends_with?("_id") ? word[0, word.size - 3] : word
  text = text.gsub("_", " ")
  text.empty? ? text : text[0].upcase.to_s + text[1, text.size - 1]
end
