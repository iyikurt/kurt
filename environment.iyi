# Where the application runs and which database it talks to. Nothing here
# opens anything: `kurt/datasource` holds the pool, and the CLI opens its
# own for `db:migrate`.
module environment

import std/text

# development, test or production; KURT_ENV picks it. Read once: a
# signed-in check asks on every request.
ENV_NAME = Program.env("KURT_ENV") || "development"

pub def env : String
  ENV_NAME
end

pub def production? : Bool
  env == "production"
end

pub def development? : Bool
  env == "development"
end

# DATABASE_URL, or the convention `sqlite3:./db/<env>.sqlite3`.
pub def database_url : String
  if url = Program.env("DATABASE_URL")
    return url unless url.empty?
  end
  "sqlite3:./db/" + env + ".sqlite3"
end

# *url* with the pool settings Kurt changes, unless it sets them itself.
# When every connection is busy, the db package sleeps `retry_delay`
# (0.2 s) before it asks again, so under load a request waited 200 ms for
# a connection that came free in microseconds. With 0 it asks at once.
pub def pool_url(url : String) : String
  return url if url.includes?("retry_delay=")
  url + (url.includes?("?") ? "&" : "?") + "retry_delay=0"
end

pub def postgres_url?(url : String) : Bool
  url.starts_with?("postgres://") || url.starts_with?("postgresql://")
end

# Rewrites the `?` placeholders a statement was built with into PostgreSQL's
# `$1, $2, ...`. A `?` inside a quoted literal is left alone.
pub def numbered_placeholders(sql : String) : String
  # Every statement on PostgreSQL passes here, so it builds into one
  # buffer: `out += c.to_s` made a string per character and copied all
  # written so far each time, 5.6 % of the allocator's time on a feed of
  # 20 rows and their comments.
  return sql unless sql.includes?("?")
  String.build(sql.bytesize + 8) do |io|
    n = 0
    quoted = false
    sql.each_char do |c|
      if c == '\''
        quoted = !quoted
        io << c
      elsif c == '?' && !quoted
        n += 1
        io << '$' << n
      else
        io << c
      end
    end
  end
end

# The secret that encrypts the session cookie: SESSION_SECRET, or in
# development and test the one `kurt new` wrote into config/application.iyi.
# Production refuses to start without its own, 32 bytes or more: the
# development one is in the repository, and anyone who has read it could
# forge a session.
pub def session_secret(development_secret : String) : String
  secret = Program.env("SESSION_SECRET") || ""
  if production?
    problem = session_secret_problem(secret)
    if problem
      STDERR.puts "kurt: " + problem
      exit 1
    end
    return secret
  end
  secret.empty? ? development_secret : secret
end

# What is wrong with *secret* for production, or nil.
pub def session_secret_problem(secret : String) : String?
  return "SESSION_SECRET is not set; production needs its own (openssl rand -hex 32)" if secret.empty?
  return "SESSION_SECRET is " + secret.bytesize.to_s + " bytes; it needs 32 or more (openssl rand -hex 32)" if secret.bytesize < 32
  nil
end
